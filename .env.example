# Copy to .env and fill in. .env holds secrets: it is never committed.
POSTGRES_PASSWORD=
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Optional: the app version to run, e.g. 1.4.0 (default latest, the newest release)
#APP_VERSION=
# Optional: the port on this machine (default 5231)
#PORT=5231
# Your email address: the first admin account, made at the first start
BOOTSTRAP_ADMIN_EMAIL=
# The address of the app from outside, for links in mails (e.g. https://du.example.nl)
PUBLIC_URL=
# Mail server for invitations and "wachtwoord vergeten"; without SMTP_HOST, admins copy the links themselves
SMTP_HOST=
#SMTP_PORT=587
# StartTls (port 587), SslOnConnect (port 465) or None
#SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: token of a Cloudflare Tunnel, for docker compose --profile tunnel (see docs/handleiding-beheer.md)
#CLOUDFLARE_TUNNEL_TOKEN=
