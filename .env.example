# Copy to .env and fill in. .env holds secrets: it is never committed.
POSTGRES_PASSWORD=
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Optional: the port on this machine (default 5231)
#PORT=5231
# Optional: choose the access and admin key yourself (only at the very first start)
#ACCESS_KEY=
#ADMIN_KEY=
# Optional: token of a Cloudflare Tunnel, for docker compose --profile tunnel (see docs/handleiding-beheer.md)
#CLOUDFLARE_TUNNEL_TOKEN=
