# The proxy in front of the app replicas (see docker-compose.yml).
# Blazor Server keeps a live connection to one replica, so a visitor must stay on the same one:
# the cookie policy sends every request of a browser to the replica it started on. When that
# replica goes away, the browser is moved to another one and the page reconnects.
{
	admin off
	auto_https off
	servers {
		# Only cloudflared (fixed address in docker-compose.yml) may pass on the visitor's address
		trusted_proxies static 172.29.53.10/32
	}
}

:8080 {
	reverse_proxy {
		# Every replica of the "app" service, looked up again as replicas come and go
		dynamic a app 8080 {
			refresh 5s
		}
		lb_policy cookie du_instance
		lb_try_duration 10s
		fail_duration 30s
	}
}
