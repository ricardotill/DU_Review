<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ScoutingAutomation.Domain\ScoutingAutomation.Domain.csproj" />
    <ProjectReference Include="..\ScoutingAutomation.Contracts\ScoutingAutomation.Contracts.csproj" />
    <ProjectReference Include="..\ScoutingAutomation.Infrastructure\ScoutingAutomation.Infrastructure.csproj" />
    <ProjectReference Include="..\ScoutingAutomation.ServiceDefaults\ScoutingAutomation.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.0" />
  </ItemGroup>

  <!-- Created at runtime and holding secrets or local state: never copy them to build or publish output -->
  <ItemGroup>
    <Content Remove="access-keys.json;access-keys.json.tmp;runtime-settings.json;runtime-settings.json.tmp" />
  </ItemGroup>
  <ItemGroup>
    <_ContentIncludedByDefault Remove="scouting_storage\_backup\20260930-175206\submissions.json" />
    <_ContentIncludedByDefault Remove="scouting_storage\_backup\20260930-180108\submissions.json" />
    <_ContentIncludedByDefault Remove="scouting_storage\_backup\20261001-112219\submissions.json" />
  </ItemGroup>

  <!-- Front-end packages come from npm (package.json); only the files the app serves are copied into wwwroot/lib -->
  <ItemGroup>
    <NpmManifest Include="package.json;package-lock.json" />
    <NpmAsset Include="node_modules/bootstrap/dist/css/bootstrap.min.css;node_modules/bootstrap/dist/css/bootstrap.min.css.map" DestinationFolder="wwwroot/lib/bootstrap/dist/css" />
    <NpmAsset Include="node_modules/bootstrap/dist/js/bootstrap.bundle.min.js;node_modules/bootstrap/dist/js/bootstrap.bundle.min.js.map" DestinationFolder="wwwroot/lib/bootstrap/dist/js" />
    <NpmAsset Include="node_modules/bootstrap-icons/font/bootstrap-icons.min.css" DestinationFolder="wwwroot/lib/bootstrap-icons/font" />
    <NpmAsset Include="node_modules/bootstrap-icons/font/fonts/bootstrap-icons.woff;node_modules/bootstrap-icons/font/fonts/bootstrap-icons.woff2" DestinationFolder="wwwroot/lib/bootstrap-icons/font/fonts" />
    <NpmAsset Include="node_modules/emoji-picker-element/index.js;node_modules/emoji-picker-element/picker.js;node_modules/emoji-picker-element/database.js" DestinationFolder="wwwroot/lib/emoji-picker-element" />
    <NpmAsset Include="node_modules/emoji-picker-element/i18n/nl.js" DestinationFolder="wwwroot/lib/emoji-picker-element/i18n" />
    <NpmAsset Include="node_modules/emoji-picker-element-data/nl/cldr/data.json" DestinationFolder="wwwroot/lib/emoji-picker-element-data/nl/cldr" />
  </ItemGroup>

  <Target Name="NpmInstall" Inputs="@(NpmManifest)" Outputs="node_modules/.install-stamp">
    <Exec Command="npm ci --no-audit --no-fund" />
    <Touch Files="node_modules/.install-stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="CopyNpmAssets" DependsOnTargets="NpmInstall" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="@(NpmAsset)" DestinationFolder="%(NpmAsset.DestinationFolder)" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="_CopiedNpmAsset" />
    </Copy>
    <!-- On a clean checkout the files did not exist when Content was globbed -->
    <ItemGroup>
      <_NpmAssetContent Include="@(NpmAsset->'%(DestinationFolder)/%(Filename)%(Extension)')" />
      <Content Remove="@(_NpmAssetContent)" />
      <Content Include="@(_NpmAssetContent)" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>5428a4d7-5c7a-4f39-a9a0-1422bcf32bb6</UserSecretsId>
  </PropertyGroup>

</Project>
