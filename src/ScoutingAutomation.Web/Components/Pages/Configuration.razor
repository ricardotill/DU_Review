@page "/configuration"
@rendermode InteractiveServer
@inject IOptions<ScoutingSettings> ScoutingOptions
@inject IServiceScopeFactory ScopeFactory
@inject SlackConnectionStatus ConnectionStatus
@inject RuntimeSettingsService Runtime

<PageTitle>Configuratie - DU Review</PageTitle>

<PageHeader Title="Configuratie" Subtitle="Wijzig de meeste instellingen in appsettings.json en herstart de app. Juryleden en de teksten van de bot pas je hier aan in beheermodus." />

<div class="row g-4">
    <!-- Groups -->
    <div class="col-12">
        <div class="glass-panel p-4">
            <h2 class="panel-title"><i class="bi bi-people-fill text-success"></i> Groepen</h2>
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Naam</th>
                            <th>Afkorting</th>
                            <th>Slack-kanaal</th>
                            <th>Omschrijving</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in groups)
                        {
                            <tr>
                                <td><a href="groups/@g.Id" class="fw-bold text-white text-decoration-none hover-underline">@g.Name</a></td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(g.Abbreviation))
                                    {
                                        <span class="text-warning small" title="Bestanden krijgen dan de naam van de groep">niet ingesteld</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary font-monospace">@g.Abbreviation</span>
                                    }
                                </td>
                                <td><span class="badge assignment-badge">#@g.SlackChannelId</span></td>
                                <td class="text-secondary small">@(g.Description ?? "–")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Review in Slack -->
    <div class="col-lg-6">
        <div class="glass-panel p-4 h-100">
            <h2 class="panel-title"><i class="bi bi-hand-thumbs-up-fill text-warning"></i> Beoordelen in Slack</h2>

            <ReviewerManager />

            <div class="d-flex flex-column gap-2">
                @foreach (var (label, badge, folder, emojis) in ReactionRows)
                {
                    <div class="inset-panel py-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge @badge">@label</span>
                            <span class="text-muted small">verhuist naar <code>/@folder/</code></span>
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var emoji in emojis)
                            {
                                <code>:@emoji.Trim(':'):</code>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Automatic feedback -->
    <div class="col-lg-6">
        <div class="glass-panel p-4 h-100">
            <h2 class="panel-title"><i class="bi bi-chat-left-text-fill text-info"></i> Automatische feedback</h2>
            <p class="text-secondary small">De bot reageert met een emoji en antwoordt in de thread als er iets mis is met een inzending. Beheerders kunnen de teksten hier aanpassen; de emoji staan in appsettings.json.</p>

            <div class="d-flex flex-column gap-2">
                @foreach (var (label, feedback, kind, placeholders) in FeedbackRows)
                {
                    <div class="inset-panel py-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-semibold text-white small">@label</span>
                            @if (string.IsNullOrWhiteSpace(feedback.Reaction))
                            {
                                <span class="text-muted small">geen emoji</span>
                            }
                            else
                            {
                                <code>:@feedback.Reaction.Trim(':'):</code>
                            }
                        </div>
                        <SlackTextEditor Kind="kind" Label="@label" Placeholders="@placeholders" EmptyText="Geen antwoord" />
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Files -->
    <div class="col-lg-6">
        <div class="glass-panel p-4 h-100">
            <h2 class="panel-title"><i class="bi bi-hdd-fill text-secondary"></i> Bestanden &amp; opslag</h2>
            <dl class="config-list mb-3">
                <dt>Opslagmap</dt>
                <dd class="font-monospace small text-break">@ServerPath(options.StorageRoot)</dd>
                <dt>Indeling</dt>
                <dd class="small"><code>/groep/</code> tot de beoordeling, daarna <code>approved/</code>, <code>awesome/</code> of <code>rejected/</code></dd>
                <dt>Bestandsnamen</dt>
                <dd class="small"><code>{afkorting} {opdracht} {tijd}</code>, bijv. <code>CDW 16 14-32-05.jpg</code></dd>
            </dl>

            <div class="field-label">Toegestane bestanden</div>
            <div class="d-flex flex-wrap gap-1">
                @foreach (var prefix in options.SupportedMimeTypePrefixes)
                {
                    <span class="badge assignment-badge">@(prefix)*</span>
                }
                @foreach (var ext in options.SupportedExtensions)
                {
                    <span class="badge bg-secondary">@ext</span>
                }
            </div>
        </div>
    </div>

    <!-- Assignments & Slack -->
    <div class="col-lg-6">
        <div class="glass-panel p-4 h-100">
            <h2 class="panel-title"><i class="bi bi-gear-fill text-secondary"></i> Opdrachten &amp; Slack</h2>
            <dl class="config-list mb-0">
                <dt>Puntenbestand</dt>
                <dd class="font-monospace small text-break">@ServerPath(options.AssignmentPointsFile)</dd>
                <dt>Opdrachten</dt>
                <dd>@assignmentCount geladen</dd>
                <dt>Handmatige modus</dt>
                <dd>
                    @(Runtime.ManualMode ? "Aan" : "Uit")
                    <span class="text-muted small ms-1">standaard @(options.ManualMode ? "aan" : "uit"); wissel op het dashboard</span>
                </dd>
                <dt>Slack-modus</dt>
                <dd>
                    @if (options.Slack.SimulationMode)
                    {
                        <span class="badge badge-pending">Simulatie</span>
                        <span class="text-muted small ms-1">geen verkeer met Slack</span>
                    }
                    else
                    {
                        <span class="badge badge-approved">Live</span>
                    }
                </dd>
                @if (!options.Slack.SimulationMode)
                {
                    <dt>Verbinding</dt>
                    <dd>
                        @if (options.Slack.SocketMode)
                        {
                            <span>Socket Mode</span>
                            <span class="badge @ConnectionBadge ms-1">@ConnectionStatus.State.Label()</span>
                            @if (!string.IsNullOrEmpty(ConnectionStatus.Detail))
                            {
                                <div class="text-muted small">@ConnectionStatus.Detail</div>
                            }
                        }
                        else
                        {
                            <span>Events API</span>
                            <span class="text-muted small ms-1">Slack stuurt naar <code>/api/slack/events</code></span>
                        }
                    </dd>
                }
                @if (options.Slack.SocketMode && !options.Slack.SimulationMode)
                {
                    <dt>App token</dt>
                    <dd>
                        @if (string.IsNullOrWhiteSpace(options.Slack.AppToken))
                        {
                            <span class="text-danger small">niet ingesteld: er komen geen gebeurtenissen binnen</span>
                        }
                        else
                        {
                            <span class="text-success small">ingesteld</span>
                        }
                    </dd>
                }
                <dt>Signing secret</dt>
                <dd>
                    @if (options.Slack.SimulationMode)
                    {
                        <span class="text-muted small">niet gecontroleerd in simulatie</span>
                    }
                    else if (options.Slack.SocketMode)
                    {
                        <span class="text-muted small">niet nodig bij Socket Mode</span>
                    }
                    else if (string.IsNullOrWhiteSpace(options.Slack.SigningSecret))
                    {
                        <span class="text-danger small">niet ingesteld: alle verzoeken van Slack worden geweigerd</span>
                    }
                    else
                    {
                        <span class="text-success small">ingesteld, verzoeken worden gecontroleerd</span>
                    }
                </dd>
                <dt>Bot token</dt>
                <dd>
                    @if (string.IsNullOrWhiteSpace(options.Slack.BotToken))
                    {
                        <span class="text-warning small">niet ingesteld</span>
                    }
                    else
                    {
                        <span class="text-success small">ingesteld</span>
                    }
                </dd>
            </dl>
        </div>
    </div>
</div>

<div class="mt-4">
    <EventTimesPanel />
</div>

<div class="mt-4">
    <ReviewRulesPanel />
</div>

<div class="mt-4">
    <AuthorizeView Roles="@KeyAuth.AdminRole">
        <Authorized>
            <AnnouncementPanel />
        </Authorized>
        <NotAuthorized>
            <div class="glass-panel p-4">
                <h2 class="panel-title"><i class="bi bi-flag-fill text-success"></i> Startbericht in Slack</h2>
                <p class="text-secondary small mb-0">Alleen beheerders kunnen het startbericht sturen. <a href="admin">Naar beheermodus</a>.</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div class="mt-4">
    <AuthorizeView Roles="@KeyAuth.AdminRole">
        <Authorized>
            <AnnouncementPanel End="true" />
        </Authorized>
        <NotAuthorized>
            <div class="glass-panel p-4">
                <h2 class="panel-title"><i class="bi bi-stopwatch-fill text-danger"></i> Eindbericht in Slack</h2>
                <p class="text-secondary small mb-0">Alleen beheerders kunnen het eindbericht sturen. <a href="admin">Naar beheermodus</a>.</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div class="mt-4">
    <AuthorizeView Roles="@KeyAuth.AdminRole">
        <Authorized>
            <RebuildPanel />
        </Authorized>
        <NotAuthorized>
            <div class="glass-panel p-4">
                <h2 class="panel-title"><i class="bi bi-arrow-repeat text-warning"></i> Opnieuw opbouwen uit Slack</h2>
                <p class="text-secondary small mb-0">Alleen beheerders kunnen opnieuw opbouwen. <a href="admin">Naar beheermodus</a>.</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ScoutingSettings options = new();
    private bool isAdmin;
    private IReadOnlyList<Group> groups = new List<Group>();
    private int assignmentCount;

    private string ConnectionBadge => ConnectionStatus.State switch
    {
        SlackConnectionState.Connected => "badge-approved",
        SlackConnectionState.Connecting => "badge-pending",
        SlackConnectionState.Error => "badge-rejected",
        _ => "badge-received"
    };

    private IEnumerable<(string Label, string Badge, string Folder, List<string> Emojis)> ReactionRows => new[]
    {
        (SubmissionStatus.Approved.StatusLabel(), "badge-approved", "approved", options.ReviewStatusReactions.Approved),
        (SubmissionStatus.Awesome.StatusLabel(), "badge-awesome", "awesome", options.ReviewStatusReactions.Awesome),
        (SubmissionStatus.Rejected.StatusLabel(), "badge-rejected", "rejected", options.ReviewStatusReactions.Rejected)
    };

    private IEnumerable<(string Label, FeedbackConfig Feedback, SlackText Kind, string? Placeholders)> FeedbackRows => new[]
    {
        ("Bestandstype niet ondersteund", options.SlackFeedback.UnsupportedFile, SlackText.UnsupportedFile, "{files}"),
        ("Geen opdrachtnummer", options.SlackFeedback.MissingAssignmentNumber, SlackText.MissingAssignmentNumber, null),
        ("Onbekend opdrachtnummer", options.SlackFeedback.UnknownAssignmentNumber, SlackText.UnknownAssignmentNumber, "{number}"),
        ("Download mislukt", options.SlackFeedback.DownloadFailed, SlackText.DownloadFailed, "{files}"),
        ("Nieuwe poging na goedkeuring", options.SlackFeedback.AlreadyCompleted, SlackText.AlreadyCompleted, "{number}"),
        ("Na de eindtijd", options.SlackFeedback.TooLate, SlackText.TooLate, "{end}")
    };

    // Where the server keeps its files is for admins; the jury sees the name only
    private string ServerPath(string? path) =>
        isAdmin ? path ?? "" : Path.GetFileName(Path.TrimEndingDirectorySeparator(path ?? ""));

    protected override async Task OnInitializedAsync()
    {
        options = ScoutingOptions.Value;
        isAdmin = await AdminActions.IsAdminAsync(AuthState);

        // A scope of its own: the tab's own database context would keep returning what it read first
        await using var scope = ScopeFactory.CreateAsyncScope();
        groups = await scope.ServiceProvider.GetRequiredService<IGroupRepository>().GetAllAsync();
        assignmentCount = (await scope.ServiceProvider.GetRequiredService<IAssignmentRepository>().GetAllAsync()).Count;
    }
}
