@page "/groups"
@rendermode InteractiveServer
@inherits LiveComponentBase

<PageTitle>Groepen - DU Review</PageTitle>

<PageHeader Title="Groepen" Subtitle="Open een groep om alle opdrachten en uploads te zien." />

@if (stats == null)
{
    <div class="empty-state">
        <div class="spinner-border text-success" role="status"></div>
    </div>
}
else if (stats.GroupStatistics.Count == 0)
{
    <div class="glass-panel empty-state">
        <i class="bi bi-people"></i>
        Geen groepen ingesteld.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var g in stats.GroupStatistics.OrderBy(x => x.Rank).ThenBy(x => x.GroupName))
        {
            var group = groupsById.GetValueOrDefault(g.GroupId);
            <div class="col-xl-3 col-md-6">
                <a href="groups/@g.GroupId" class="glass-panel group-card d-block p-4 h-100 text-decoration-none">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="min-w-0">
                            <div class="fw-bold text-white fs-5 text-truncate">@g.GroupName</div>
                            @if (!string.IsNullOrWhiteSpace(group?.Abbreviation))
                            {
                                <span class="badge bg-secondary font-monospace">@group.Abbreviation</span>
                            }
                        </div>
                        <span class="rank-badge" title="Plaats op het scorebord">#@g.Rank</span>
                    </div>

                    <div class="stat-value text-white">@g.Score <span class="fs-6 text-secondary fw-normal">punten</span></div>
                    <div class="stat-caption mb-3">@g.TotalSubmissions @(g.TotalSubmissions == 1 ? "opdracht" : "opdrachten") ingezonden</div>

                    <div class="d-flex gap-3 small">
                        <span class="text-warning" title="Open"><i class="bi bi-hourglass-split"></i> @g.PendingCount</span>
                        <span class="text-success" title="Goedgekeurd"><i class="bi bi-check2"></i> @g.ApprovedCount</span>
                        <span class="text-awesome" title="Awesome"><i class="bi bi-star-fill"></i> @g.AwesomeCount</span>
                        <span class="text-danger" title="Afgekeurd"><i class="bi bi-x-circle"></i> @g.RejectedCount</span>
                    </div>
                </a>
            </div>
        }
    </div>
}

@code {
    private SubmissionStatistics? stats;
    private Dictionary<Guid, Group> groupsById = new();

    protected override Task OnInitializedAsync() => ReloadAsync();

    protected override async Task LoadAsync(IServiceProvider services)
    {
        stats = await services.GetRequiredService<ISubmissionRepository>().GetStatisticsAsync();
        groupsById = (await services.GetRequiredService<IGroupRepository>().GetAllAsync()).ToDictionary(g => g.Id);
    }
}
