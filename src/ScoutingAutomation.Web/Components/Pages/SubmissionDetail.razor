@page "/submissions/{Id:guid}"
@rendermode InteractiveServer
@inherits LiveComponentBase
@inject RuntimeSettingsService Runtime
@attribute [GroupAccess]

<PageTitle>Inzending - DU Review</PageTitle>

@if (!loaded)
{
    <div class="empty-state">
        <div class="spinner-border text-success" role="status"></div>
    </div>
}
else if (submission == null)
{
    <PageHeader Title="Inzending niet gevonden" BackHref="submissions" BackText="Inzendingen" />
}
else
{
    var fileUrl = $"/api/files/{submission.Id}";

    <PageHeader Title="@StoredFileName" BackHref="submissions" BackText="Inzendingen">
        <Details>
            <div class="d-flex align-items-center gap-2 flex-wrap mt-2">
                <StatusBadge Status="@submission.Status" />
                @* The group and assignment pages are for the jury *@
                @if (!IsGroup)
                {
                    <a href="groups/@submission.GroupId" class="badge bg-secondary text-decoration-none">@(submission.Group?.Name ?? "Onbekende groep")</a>
                }
                @if (submission.AssignmentCode == null)
                {
                    <span class="badge bg-danger">Onopgelost</span>
                }
                else if (submission.Kind == SubmissionKind.CheckIn)
                {
                    <span class="badge assignment-badge">Check-in locatie @submission.AssignmentCode</span>
                }
                else if (submission.Kind == SubmissionKind.Theme)
                {
                    <span class="badge assignment-badge">Half-uur opdracht @submission.AssignmentCode</span>
                }
                else if (IsGroup)
                {
                    <span class="badge assignment-badge">Opdracht @submission.AssignmentCode</span>
                }
                else
                {
                    <a href="assignments/@submission.AssignmentCode" class="badge assignment-badge text-decoration-none">Opdracht @submission.AssignmentCode</a>
                }
            </div>
        </Details>
        <Actions>
            @if (!IsGroup)
            {
                <span class="align-self-center fs-5"><FavoriteStar Submission="submission" /></span>
            }
            @* Groups see their file in Slack: downloading it from the app would use the location's bandwidth *@
            @if (!IsGroup)
            {
                <a href="@fileUrl" download="@submission.FileName" class="btn btn-scout-secondary d-flex align-items-center gap-2 download-file">
                    <i class="bi bi-download"></i>
                    <span>Download</span>
                </a>
            }
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrEmpty(submission.UnresolvedReason))
    {
        <div class="alert alert-warning small d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span><strong>Niet gekoppeld aan een opdracht:</strong> @submission.UnresolvedReason</span>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7 d-flex flex-column gap-4">
            <!-- Preview -->
            <div class="glass-panel p-3">
                @if (IsGroup)
                {
                    <div class="text-center py-4 group-preview">
                        <div class="fs-1 mb-2"><FileIcon ContentType="@submission.ContentType" /></div>
                        <OpenInSlack ChannelId="@submission.SlackChannelId" MessageTs="@submission.SlackMessageId" PostedAt="submission.CreatedAt" />
                    </div>
                }
                else
                {
                <div class="preview">
                    @if (submission.ContentType.StartsWith("image/"))
                    {
                        <img src="@fileUrl" alt="@submission.FileName" />
                    }
                    else if (submission.ContentType.StartsWith("video/"))
                    {
                        <video controls src="@fileUrl"></video>
                    }
                    else if (submission.ContentType.StartsWith("audio/"))
                    {
                        <audio controls src="@fileUrl" class="w-75"></audio>
                    }
                    else
                    {
                        <div class="text-center">
                            <div class="fs-1 mb-2"><FileIcon ContentType="@submission.ContentType" /></div>
                            <div class="text-secondary small mb-3">Geen voorbeeld voor dit bestandstype</div>
                            <a href="@fileUrl" target="_blank" class="btn btn-scout-secondary btn-sm">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Bestand openen
                            </a>
                        </div>
                    }
                </div>
                }
            </div>

            <!-- Slack message -->
            <div class="glass-panel p-4">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <h2 class="panel-title"><i class="bi bi-slack" style="color: #e01e5a;"></i> Slack-bericht</h2>
                    @if (!IsGroup)
                    {
                        <div class="d-flex gap-1"><SlackMessageLinks ChannelId="@submission.SlackChannelId" MessageTs="@submission.SlackMessageId" /></div>
                    }
                </div>
                <div class="slack-message">
                    <div class="d-flex justify-content-between flex-wrap gap-2 mb-2 small">
                        <span class="fw-bold text-white" title="@submission.Submitter">@submission.SubmitterDisplayName</span>
                        <span class="text-muted">@submission.CreatedAt.ToGameTime().ToString("f")</span>
                    </div>
                    <div class="text-white-50 text-break">
                        @(string.IsNullOrWhiteSpace(submission.MessageText) ? "(geen tekst)" : submission.MessageText)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5 d-flex flex-column gap-4">
            <!-- Details -->
            <div class="glass-panel p-4">
                <h2 class="panel-title"><i class="bi bi-info-circle text-info"></i> Details</h2>
                <dl class="detail-list mb-0">
                    <dt>Oorspronkelijke naam</dt>
                    <dd class="text-break">@submission.FileName</dd>
                    <dt>Type</dt>
                    <dd>@submission.ContentType · @FormatFileSize(submission.FileSizeBytes)</dd>
                    @* Where the jury finds it; a group has no use for it *@
                    @if (!IsGroup)
                    {
                        <dt>Kanaal</dt>
                        <dd>#@submission.SlackChannelId</dd>
                        <dt>Bericht-ID</dt>
                        <dd class="font-monospace small">@submission.SlackMessageId</dd>
                        <dt>Opgeslagen in</dt>
                        <dd class="font-monospace small text-info text-break">@submission.StoragePath</dd>
                    }
                </dl>
            </div>

            <!-- Review timeline -->
            <div class="glass-panel p-4">
                <h2 class="panel-title"><i class="bi bi-clock-history text-secondary"></i> Beoordelingen</h2>

                @if (submission.Reviews.Count == 0)
                {
                    <div class="text-muted small">Nog geen beoordeling. Wacht op een reactie in Slack.</div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var rev in submission.Reviews.OrderByDescending(r => r.CreatedAt))
                        {
                            <div class="timeline-item" style="border-left-color: @GetReviewColor(rev.Status);">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    @* A group sees what was decided, not who decided it *@
                                    <span class="fw-semibold text-white text-truncate" title="@(IsGroup ? null : rev.Reviewer)">@(IsGroup ? "Jury" : Runtime.DisplayName(rev.Reviewer))</span>
                                    <StatusBadge Status="@rev.Status" />
                                </div>
                                <div class="text-muted small mt-1">
                                    @rev.CreatedAt.ToGameTime().ToString("g")
                                    @if (!string.IsNullOrEmpty(rev.ReactionEmoji) && !IsGroup)
                                    {
                                        <span> · <code>:@rev.ReactionEmoji:</code></span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(rev.Notes) && !IsGroup)
                                {
                                    <div class="text-white-50 small mt-1">@rev.Notes</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <AuthorizeView Roles="@KeyAuth.AdminRole">
                <!-- Emergency status override, hidden by default: reviews belong in Slack -->
                <details class="override-panel">
                    <summary class="text-secondary small">Status handmatig aanpassen…</summary>

                    <div class="glass-panel p-4 mt-2 override-body">
                        <div class="alert alert-warning small mb-3" role="alert">
                            <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Gebruik dit alleen om problemen op te lossen</div>
                            <ul class="mb-0 ps-3">
                                <li>Beoordelen gebeurt in Slack. Juryleden reageren daar.</li>
                                <li>Slack verandert niet: er komt geen reactie op het bericht.</li>
                                <li>Een latere reactie van een jurylid in Slack overschrijft deze status.</li>
                                <li>De aanpassing komt met je reden bij de beoordelingen te staan.</li>
                                @if (filesInMessage > 1)
                                {
                                    <li class="override-siblings">Geldt voor alle @filesInMessage bestanden van dit bericht, net als een reactie in Slack.</li>
                                }
                            </ul>
                        </div>

                        <div class="mb-2">
                            <label class="form-label text-secondary small fw-semibold mb-1">Nieuwe status</label>
                            <select class="form-select form-select-dark" @bind="overrideStatus">
                                @foreach (var status in OverrideStatuses)
                                {
                                    <option value="@status" disabled="@(status == submission.Status)">@status.StatusLabel()@(status == submission.Status ? " (huidig)" : "")</option>
                                }
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="form-label text-secondary small fw-semibold mb-1">Reden (verplicht)</label>
                            <textarea class="form-control form-control-dark" rows="2" maxlength="@SubmissionWorkflowService.MaxOverrideReasonLength" placeholder="Waarom wordt dit buiten Slack aangepast?"
                                      @bind="overrideReason" @bind:event="oninput"></textarea>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="overrideConfirm" @bind="overrideConfirmed" />
                            <label class="form-check-label text-white-50 small" for="overrideConfirm">
                                Ik begrijp dat dit de beoordeling in Slack omzeilt
                            </label>
                        </div>

                        <button class="btn btn-outline-warning btn-sm" disabled="@(!CanOverride)" @onclick="OverrideStatusAsync">
                            <i class="bi bi-exclamation-triangle me-1"></i> Status aanpassen
                        </button>

                        @if (overrideError != null)
                        {
                            <div class="text-danger small mt-2">@overrideError</div>
                        }
                    </div>
                </details>
            </AuthorizeView>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter]
    public Guid Id { get; set; }

    private Submission? submission;
    private bool loaded;

    // An override reviews every file of the Slack message, like an emoji does
    private int filesInMessage;

    private string StoredFileName =>
        submission == null ? string.Empty
        : string.IsNullOrWhiteSpace(submission.StoragePath) ? submission.FileName
        : Path.GetFileName(submission.StoragePath);

    private static readonly SubmissionStatus[] OverrideStatuses =
        { SubmissionStatus.Pending, SubmissionStatus.Approved, SubmissionStatus.Awesome, SubmissionStatus.Rejected };

    private SubmissionStatus? overrideStatus;
    private string overrideReason = string.Empty;
    private bool overrideConfirmed;
    private string? overrideError;
    private bool overriding;

    private bool CanOverride =>
        !overriding
        && submission != null
        && overrideStatus.HasValue
        && overrideStatus != submission.Status
        && overrideConfirmed
        && !string.IsNullOrWhiteSpace(overrideReason);

    // Set for a group login: only its own submissions can be opened
    private Guid? ownGroup;
    private bool IsGroup => ownGroup.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        if (!loaded) ownGroup = AuthState == null ? null : KeyAuth.GroupId((await AuthState).User);
        await ReloadAsync();
    }

    protected override async Task LoadAsync(IServiceProvider services)
    {
        submission = await services.GetRequiredService<ISubmissionRepository>().GetByIdAsync(Id);
        // Another group's submission looks the same as one that does not exist
        if (ownGroup is { } own && submission?.GroupId != own) submission = null;
        filesInMessage = submission == null ? 0
            : (await services.GetRequiredService<ISubmissionRepository>().GetBySlackMessageIdAsync(submission.SlackChannelId, submission.SlackMessageId)).Count;
        loaded = true;

        // Keep what the user picked in the override form, unless it became the current status
        if (overrideStatus == null || overrideStatus == submission?.Status)
        {
            overrideStatus = OverrideStatuses.FirstOrDefault(s => s != submission?.Status);
        }
    }

    private async Task OverrideStatusAsync()
    {
        // A double click would add the override twice
        if (!CanOverride) return;
        overriding = true;

        try
        {
            if (!await AdminActions.IsAdminAsync(AuthState))
            {
                overrideError = AdminActions.NotAdmin;
                return;
            }

            var submissionId = submission!.Id;
            var newStatus = overrideStatus!.Value;
            await RunInNewScopeAsync(services =>
                services.GetRequiredService<ISubmissionWorkflowService>().OverrideStatusAsync(submissionId, newStatus, overrideReason));
            overrideReason = string.Empty;
            overrideConfirmed = false;
            overrideError = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            overrideError = $"Aanpassen mislukt: {ex.Message}";
        }
        finally
        {
            overriding = false;
        }
    }

    private static string GetReviewColor(SubmissionStatus status) => status switch
    {
        SubmissionStatus.Approved => "#10b981",
        SubmissionStatus.Awesome => "#a855f7",
        SubmissionStatus.Rejected => "#ef4444",
        _ => "#f59e0b"
    };

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
