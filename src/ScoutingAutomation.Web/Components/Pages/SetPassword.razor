@page "/wachtwoord-instellen"
@layout LoginLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject AccountService Accounts
@inject SignInManager<AppUser> SignIn
@inject NavigationManager Navigation

<PageTitle>Wachtwoord kiezen - DU Review</PageTitle>

<h1 class="h5 text-white text-center mb-3">Kies je wachtwoord</h1>

<p class="text-secondary small">Minstens 10 tekens. Een zin van een paar woorden is makkelijk te onthouden en moeilijk te raden.</p>

<EditForm Model="Input" method="post" OnSubmit="SetAsync" FormName="set-password">
    <input type="hidden" name="Input.Id" value="@(Input.Id ?? Id)" />
    <input type="hidden" name="Input.Code" value="@(Input.Code ?? Code)" />
    <InputText type="password" class="form-control form-control-dark mb-2" @bind-Value="Input.Password"
               placeholder="Nieuw wachtwoord" autocomplete="new-password" aria-label="Nieuw wachtwoord" autofocus />
    <InputText type="password" class="form-control form-control-dark mb-2" @bind-Value="Input.Repeat"
               placeholder="Nog een keer" autocomplete="new-password" aria-label="Wachtwoord herhalen" />
    @if (error != null)
    {
        <div class="text-danger small mb-2" role="alert">@error</div>
    }
    <button type="submit" class="btn btn-scout-primary w-100">Wachtwoord opslaan</button>
</EditForm>

<p class="text-center small mt-3 mb-0"><a href="login">Naar inloggen</a></p>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    private string? Id { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    [SupplyParameterFromForm]
    private PasswordInput Input { get; set; } = default!;

    private string? error;

    protected override void OnInitialized() => Input ??= new();

    private async Task SetAsync()
    {
        if (Input.Password != Input.Repeat)
        {
            error = "De twee wachtwoorden zijn niet hetzelfde.";
            return;
        }

        var (user, problem) = await Accounts.SetPasswordAsync(Input.Id, Input.Code, Input.Password);
        if (user == null)
        {
            error = problem;
            return;
        }

        // Straight in: the link proved the address, the password was just chosen
        await SignIn.SignInAsync(user, isPersistent: true);
        Navigation.NavigateTo("/");
    }

    private sealed class PasswordInput
    {
        public string? Id { get; set; }
        public string? Code { get; set; }
        public string? Password { get; set; }
        public string? Repeat { get; set; }
    }
}
