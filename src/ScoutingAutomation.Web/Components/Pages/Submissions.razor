@page "/submissions"
@rendermode InteractiveServer
@inherits LiveComponentBase
@inject RuntimeSettingsService Runtime
@inject FavoritesService Favorites
@attribute [GroupAccess]

<PageTitle>Inzendingen - DU Review</PageTitle>

@if (IsGroup)
{
    <PageHeader Title="Onze inzendingen" Subtitle="Alle uploads van jullie groep, met de beoordeling van de jury." />
}
else
{
    <PageHeader Title="Inzendingen" Subtitle="Zoek en filter alle uploads. Beoordelen gebeurt in Slack." />
}

<!-- Filters -->
<div class="glass-panel p-3 mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-lg-4 col-md-12">
            <label class="form-label text-secondary small fw-semibold mb-1">Zoeken</label>
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control form-control-dark" placeholder="Bestandsnaam, scout of bericht"
                       @bind="filter.SearchTerm" @bind:event="oninput" @bind:after="SearchAsync" />
            </div>
        </div>

        @* A group only ever sees its own uploads: no group or jury filter *@
        @if (!IsGroup)
        {
            <div class="col-lg-2 col-md-3 col-6">
                <label class="form-label text-secondary small fw-semibold mb-1">Groep</label>
                <select class="form-select form-select-dark" @bind="selectedGroupId" @bind:after="SearchAsync">
                    <option value="">Alle groepen</option>
                    @foreach (var g in groups)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>
            </div>
        }

        @if (Runtime.AdventurersEnabled)
        {
            <div class="col-lg-2 col-md-3 col-6">
                <label class="form-label text-secondary small fw-semibold mb-1">Soort</label>
                <select class="form-select form-select-dark kind-filter" @bind="selectedKind" @bind:after="SearchAsync">
                    <option value="">Alles</option>
                    @foreach (var kind in Enum.GetValues<SubmissionKind>())
                    {
                        <option value="@kind">@kind.KindLabel()</option>
                    }
                </select>
            </div>
        }

        <div class="col-lg-2 col-md-3 col-6">
            <label class="form-label text-secondary small fw-semibold mb-1">Opdracht</label>
            <select class="form-select form-select-dark" @bind="selectedAssignmentCode" @bind:after="SearchAsync">
                <option value="">Alle opdrachten</option>
                @foreach (var a in assignments)
                {
                    <option value="@a.Code">#@a.Code@(a.Title != null ? $" · {a.Title}" : "")</option>
                }
            </select>
        </div>

        <div class="col-lg-2 col-md-3 col-6">
            <label class="form-label text-secondary small fw-semibold mb-1">Status</label>
            <select class="form-select form-select-dark" @bind="selectedStatus" @bind:after="SearchAsync">
                <option value="">Alle statussen</option>
                @foreach (var s in new[] { SubmissionStatus.Pending, SubmissionStatus.Approved, SubmissionStatus.Awesome, SubmissionStatus.Rejected })
                {
                    <option value="@s">@s.StatusLabel()</option>
                }
            </select>
        </div>

        @if (!IsGroup)
        {
            <div class="col-lg-2 col-md-3 col-6">
                <label class="form-label text-secondary small fw-semibold mb-1">Jurylid</label>
                <input type="text" class="form-control form-control-dark" placeholder="Naam of Slack-ID"
                       @bind="filter.Reviewer" @bind:event="oninput" @bind:after="SearchAsync" />
            </div>
        }
    </div>
</div>

<!-- Results -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h6 fw-bold text-white mb-0">
            @VisibleSubmissions.Count @(VisibleSubmissions.Count == 1 ? "inzending" : "inzendingen")
            <span class="text-secondary fw-normal small ms-1">nieuwste eerst</span>
        </h2>
        @if (!IsGroup)
        {
            <div class="form-check form-switch mb-0 ms-auto me-3">
                <input class="form-check-input" type="checkbox" role="switch" id="favoritesOnly" @bind="favoritesOnly" @bind:after="FirstPage" disabled="@(!Favorites.IsLoaded)" />
                <label class="form-check-label text-secondary small" for="favoritesOnly">
                    <i class="bi bi-star-fill text-warning"></i> Alleen favorieten (@Favorites.Count)
                </label>
            </div>
            <a href="@SlideshowHref" class="btn btn-sm btn-scout-secondary d-flex align-items-center gap-1 me-2 slideshow-link" title="Toon deze foto's, video's en geluidsopnames als diavoorstelling">
                <i class="bi bi-play-btn"></i>
                <span>Diavoorstelling</span>
            </a>
        }
        else
        {
            <span class="ms-auto"></span>
        }
        @if (HasActiveFilters)
        {
            <button class="btn btn-sm btn-scout-secondary d-flex align-items-center gap-1" @onclick="ResetFilters">
                <i class="bi bi-x-lg"></i>
                <span>Filters wissen</span>
            </button>
        }
    </div>

    @{
        var visible = VisibleSubmissions;
    }

    @if (visible.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            Geen inzendingen met deze filters.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        @if (!IsGroup)
                        {
                            <th style="width: 2.5rem;"><span class="visually-hidden">Favoriet</span></th>
                        }
                        <th>Bestand</th>
                        @if (!IsGroup)
                        {
                            <th>Groep</th>
                        }
                        <th>Opdracht</th>
                        <th>Status</th>
                        <th>Ingezonden</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in Pager.Slice(visible, page))
                    {
                        var storedName = GetStoredFileName(sub);
                        <tr>
                            @if (!IsGroup)
                            {
                                <td><FavoriteStar Submission="sub" /></td>
                            }
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="file-icon">
                                        <FileIcon ContentType="@sub.ContentType" />
                                    </div>
                                    <div class="file-name">
                                        <a href="submissions/@sub.Id" class="fw-semibold text-white text-decoration-none hover-underline text-truncate d-block">
                                            @storedName
                                        </a>
                                        <div class="text-muted small text-truncate">
                                            @if (storedName != sub.FileName)
                                            {
                                                <span title="Oorspronkelijke bestandsnaam">@sub.FileName · </span>
                                            }
                                            @FormatFileSize(sub.FileSizeBytes)
                                        </div>
                                    </div>
                                </div>
                            </td>
                            @if (!IsGroup)
                            {
                                <td>
                                    <a href="groups/@sub.GroupId" class="text-white text-decoration-none hover-underline">@(sub.Group?.Name ?? "Onbekend")</a>
                                </td>
                            }
                            <td>
                                @if (sub.AssignmentCode != null && (IsGroup || sub.Kind.IsAdventurers()))
                                {
                                    <span class="badge assignment-badge">#@sub.CodeLabel</span>
                                    @if (sub.Kind.IsAdventurers())
                                    {
                                        <span class="badge bg-info text-dark ms-1 kind-badge">@sub.Kind.KindLabel()</span>
                                    }
                                }
                                else if (sub.AssignmentCode != null)
                                {
                                    <a href="assignments/@sub.AssignmentCode" class="badge assignment-badge text-decoration-none" title="Opdracht openen">#@sub.AssignmentCode</a>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Onopgelost</span>
                                    @if (!string.IsNullOrWhiteSpace(sub.UnresolvedReason))
                                    {
                                        <div class="text-muted small text-truncate unresolved-reason" title="@sub.UnresolvedReason">@sub.UnresolvedReason</div>
                                    }
                                }
                            </td>
                            <td>
                                <StatusBadge Status="@sub.Status" />
                            </td>
                            <td>
                                <div class="text-white-50" title="@sub.Submitter">@sub.SubmitterDisplayName</div>
                                <div class="text-muted small">@sub.CreatedAt.ToGameTime().ToString("g")</div>
                            </td>
                            <td class="text-end">
                                <a href="submissions/@sub.Id" class="btn btn-sm btn-scout-secondary" title="Details bekijken" aria-label="Details bekijken">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager TotalCount="visible.Count" @bind-Page="page" />
    }
</div>

@code {
    private SubmissionFilter filter = new();
    private List<Submission> submissions = new();
    private IReadOnlyList<Group> groups = new List<Group>();
    private IReadOnlyList<Assignment> assignments = new List<Assignment>();

    private string? selectedGroupId;
    private string? selectedAssignmentCode;
    private string? selectedStatus;
    private string? selectedKind;

    [SupplyParameterFromQuery(Name = "group")]
    public Guid? GroupFromQuery { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // Set for a group login: every search is limited to this group, whatever the page is asked
    private Guid? ownGroup;
    private bool IsGroup => ownGroup.HasValue;

    protected override async Task OnInitializedAsync()
    {
        ownGroup = AuthState == null ? null : AppAuth.GroupId((await AuthState).User);
        if (GroupFromQuery.HasValue && !IsGroup)
        {
            selectedGroupId = GroupFromQuery.Value.ToString();
        }

        await ReloadAsync();
    }

    private int page = 1;

    private Task SearchAsync()
    {
        FirstPage();
        return ReloadAsync();
    }

    private void FirstPage() => page = 1;

    protected override async Task LoadAsync(IServiceProvider services)
    {
        if (assignments.Count == 0)
        {
            // A group does not get the names of the others
            if (!IsGroup) groups = await services.GetRequiredService<IGroupRepository>().GetAllAsync();
            assignments = await services.GetRequiredService<IAssignmentRepository>().GetAllAsync();
        }

        if (ownGroup is { } own)
        {
            filter.GroupId = own;
            filter.Reviewer = null;
        }
        else if (Guid.TryParse(selectedGroupId, out var gId))
        {
            filter.GroupId = gId;
        }
        else
        {
            filter.GroupId = null;
        }

        filter.AssignmentCode = AssignmentCode.Normalize(selectedAssignmentCode);
        // The assignment list holds Toeristen assignments: a check-in or theme with that number is not meant
        filter.Kind = Enum.TryParse<SubmissionKind>(selectedKind, out var kind) ? kind
            : filter.AssignmentCode != null ? SubmissionKind.Assignment
            : null;

        if (Enum.TryParse<SubmissionStatus>(selectedStatus, out var status))
        {
            filter.Status = status;
        }
        else
        {
            filter.Status = null;
        }

        // Reviews store Slack IDs; typing a reviewer's name finds their reviews too
        var reviewerTerm = filter.Reviewer?.Trim() ?? "";
        filter.ReviewerIds = reviewerTerm.Length == 0
            ? Array.Empty<string>()
            : Runtime.AllReviewers.Where(id => Runtime.NameOf(id)?.Contains(reviewerTerm, StringComparison.OrdinalIgnoreCase) == true).ToList();

        var results = await services.GetRequiredService<ISubmissionRepository>().SearchSubmissionsAsync(filter);
        submissions = results.ToList();
    }

    private async Task ResetFilters()
    {
        filter = new SubmissionFilter();
        favoritesOnly = false;
        selectedGroupId = null;
        selectedAssignmentCode = null;
        selectedStatus = null;
        selectedKind = null;
        await SearchAsync();
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private bool favoritesOnly;

    /// <summary>Opens the slideshow with the same group, assignment, status and favorites choice.</summary>
    private string SlideshowHref
    {
        get
        {
            var query = new List<string>();
            if (Guid.TryParse(selectedGroupId, out var groupId)) query.Add($"group={groupId}");
            if (AssignmentCode.Normalize(selectedAssignmentCode) is { } code) query.Add($"assignment={code}");
            if (Enum.TryParse<SubmissionStatus>(selectedStatus, out var status)) query.Add($"status={status}");
            if (favoritesOnly) query.Add("favorites=true");
            return query.Count == 0 ? "slideshow" : $"slideshow?{string.Join('&', query)}";
        }
    }

    private List<Submission> VisibleSubmissions => favoritesOnly ? submissions.Where(Favorites.IsFavorite).ToList() : submissions;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Favorites.Changed += OnFavoritesChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Favorites.EnsureLoadedAsync();
        }
    }

    private void OnFavoritesChanged() => InvokeAsync(StateHasChanged);

    protected override void Dispose(bool disposing)
    {
        Favorites.Changed -= OnFavoritesChanged;
        base.Dispose(disposing);
    }

    private bool HasActiveFilters =>
        favoritesOnly
        || !string.IsNullOrWhiteSpace(filter.SearchTerm)
        || !string.IsNullOrWhiteSpace(filter.Reviewer)
        || !string.IsNullOrEmpty(selectedGroupId)
        || !string.IsNullOrEmpty(selectedAssignmentCode)
        || !string.IsNullOrEmpty(selectedStatus)
        || !string.IsNullOrEmpty(selectedKind);

    private static string GetStoredFileName(Submission sub) =>
        string.IsNullOrWhiteSpace(sub.StoragePath) ? sub.FileName : Path.GetFileName(sub.StoragePath);
}
