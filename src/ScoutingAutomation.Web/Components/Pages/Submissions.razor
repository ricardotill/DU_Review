@page "/submissions"
@rendermode InteractiveServer
@inherits LiveComponentBase
@inject RuntimeSettingsService Runtime
@inject FavoritesService Favorites

<PageTitle>Submissions - Scouting Regional Game</PageTitle>

<PageHeader Title="Submissions" Subtitle="Search and filter all uploads. Reviewing happens in Slack." />

<!-- Filters -->
<div class="glass-panel p-3 mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-lg-4 col-md-12">
            <label class="form-label text-secondary small fw-semibold mb-1">Search</label>
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control form-control-dark" placeholder="File name, scout or message"
                       @bind="filter.SearchTerm" @bind:event="oninput" @bind:after="SearchAsync" />
            </div>
        </div>

        <div class="col-lg-2 col-md-3 col-6">
            <label class="form-label text-secondary small fw-semibold mb-1">Group</label>
            <select class="form-select form-select-dark" @bind="selectedGroupId" @bind:after="SearchAsync">
                <option value="">All groups</option>
                @foreach (var g in groups)
                {
                    <option value="@g.Id">@g.Name</option>
                }
            </select>
        </div>

        <div class="col-lg-2 col-md-3 col-6">
            <label class="form-label text-secondary small fw-semibold mb-1">Assignment</label>
            <select class="form-select form-select-dark" @bind="selectedAssignmentNumber" @bind:after="SearchAsync">
                <option value="">All assignments</option>
                @foreach (var a in assignments)
                {
                    <option value="@a.Number">#@a.Number</option>
                }
            </select>
        </div>

        <div class="col-lg-2 col-md-3 col-6">
            <label class="form-label text-secondary small fw-semibold mb-1">Status</label>
            <select class="form-select form-select-dark" @bind="selectedStatus" @bind:after="SearchAsync">
                <option value="">All statuses</option>
                <option value="@SubmissionStatus.Pending">Pending</option>
                <option value="@SubmissionStatus.Approved">Approved</option>
                <option value="@SubmissionStatus.Awesome">Awesome</option>
                <option value="@SubmissionStatus.Rejected">Rejected</option>
            </select>
        </div>

        <div class="col-lg-2 col-md-3 col-6">
            <label class="form-label text-secondary small fw-semibold mb-1">Reviewer</label>
            <input type="text" class="form-control form-control-dark" placeholder="Name or Slack ID"
                   @bind="filter.Reviewer" @bind:event="oninput" @bind:after="SearchAsync" />
        </div>
    </div>
</div>

<!-- Results -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h6 fw-bold text-white mb-0">
            @VisibleSubmissions.Count @(VisibleSubmissions.Count == 1 ? "submission" : "submissions")
            <span class="text-secondary fw-normal small ms-1">newest first</span>
        </h2>
        <div class="form-check form-switch mb-0 ms-auto me-3">
            <input class="form-check-input" type="checkbox" role="switch" id="favoritesOnly" @bind="favoritesOnly" disabled="@(!Favorites.IsLoaded)" />
            <label class="form-check-label text-secondary small" for="favoritesOnly">
                <i class="bi bi-star-fill text-warning"></i> Favorites only (@Favorites.Count)
            </label>
        </div>
        <a href="@SlideshowHref" class="btn btn-sm btn-scout-secondary d-flex align-items-center gap-1 me-2 slideshow-link" title="Show these photos, videos and audio as a slideshow">
            <i class="bi bi-play-btn"></i>
            <span>Slideshow</span>
        </a>
        @if (HasActiveFilters)
        {
            <button class="btn btn-sm btn-scout-secondary d-flex align-items-center gap-1" @onclick="ResetFilters">
                <i class="bi bi-x-lg"></i>
                <span>Clear filters</span>
            </button>
        }
    </div>

    @if (VisibleSubmissions.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            No submissions match these filters.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th style="width: 2.5rem;"><span class="visually-hidden">Favorite</span></th>
                        <th>File</th>
                        <th>Group</th>
                        <th>Assignment</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in VisibleSubmissions)
                    {
                        var storedName = GetStoredFileName(sub);
                        <tr>
                            <td><FavoriteStar Submission="sub" /></td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="file-icon">
                                        <FileIcon ContentType="@sub.ContentType" />
                                    </div>
                                    <div class="file-name">
                                        <a href="submissions/@sub.Id" class="fw-semibold text-white text-decoration-none hover-underline text-truncate d-block">
                                            @storedName
                                        </a>
                                        <div class="text-muted small text-truncate">
                                            @if (storedName != sub.FileName)
                                            {
                                                <span title="Original file name">@sub.FileName · </span>
                                            }
                                            @FormatFileSize(sub.FileSizeBytes)
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="groups/@sub.GroupId" class="text-white text-decoration-none hover-underline">@(sub.Group?.Name ?? "Unknown")</a>
                            </td>
                            <td>
                                @if (sub.AssignmentNumber.HasValue)
                                {
                                    <a href="assignments/@sub.AssignmentNumber" class="badge assignment-badge text-decoration-none" title="Open assignment">#@sub.AssignmentNumber</a>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Unresolved</span>
                                    @if (!string.IsNullOrWhiteSpace(sub.UnresolvedReason))
                                    {
                                        <div class="text-muted small text-truncate unresolved-reason" title="@sub.UnresolvedReason">@sub.UnresolvedReason</div>
                                    }
                                }
                            </td>
                            <td>
                                <StatusBadge Status="@sub.Status" />
                            </td>
                            <td>
                                <div class="text-white-50" title="@sub.Submitter">@sub.SubmitterDisplayName</div>
                                <div class="text-muted small">@sub.CreatedAt.ToGameTime().ToString("g")</div>
                            </td>
                            <td class="text-end">
                                <a href="submissions/@sub.Id" class="btn btn-sm btn-scout-secondary" title="View details" aria-label="View details">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private SubmissionFilter filter = new();
    private List<Submission> submissions = new();
    private IReadOnlyList<Group> groups = new List<Group>();
    private IReadOnlyList<Assignment> assignments = new List<Assignment>();

    private string? selectedGroupId;
    private string? selectedAssignmentNumber;
    private string? selectedStatus;

    [SupplyParameterFromQuery(Name = "group")]
    public Guid? GroupFromQuery { get; set; }

    protected override Task OnInitializedAsync()
    {
        if (GroupFromQuery.HasValue)
        {
            selectedGroupId = GroupFromQuery.Value.ToString();
        }

        return ReloadAsync();
    }

    private Task SearchAsync() => ReloadAsync();

    protected override async Task LoadAsync(IServiceProvider services)
    {
        if (groups.Count == 0)
        {
            groups = await services.GetRequiredService<IGroupRepository>().GetAllAsync();
            assignments = await services.GetRequiredService<IAssignmentRepository>().GetAllAsync();
        }

        if (Guid.TryParse(selectedGroupId, out var gId))
        {
            filter.GroupId = gId;
        }
        else
        {
            filter.GroupId = null;
        }

        if (int.TryParse(selectedAssignmentNumber, out var aNum))
        {
            filter.AssignmentNumber = aNum;
        }
        else
        {
            filter.AssignmentNumber = null;
        }

        if (Enum.TryParse<SubmissionStatus>(selectedStatus, out var status))
        {
            filter.Status = status;
        }
        else
        {
            filter.Status = null;
        }

        // Reviews store Slack IDs; typing a reviewer's name finds their reviews too
        var reviewerTerm = filter.Reviewer?.Trim() ?? "";
        filter.ReviewerIds = reviewerTerm.Length == 0
            ? Array.Empty<string>()
            : Runtime.AllReviewers.Where(id => Runtime.NameOf(id)?.Contains(reviewerTerm, StringComparison.OrdinalIgnoreCase) == true).ToList();

        var results = await services.GetRequiredService<ISubmissionRepository>().SearchSubmissionsAsync(filter);
        submissions = results.ToList();
    }

    private async Task ResetFilters()
    {
        filter = new SubmissionFilter();
        favoritesOnly = false;
        selectedGroupId = null;
        selectedAssignmentNumber = null;
        selectedStatus = null;
        await SearchAsync();
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private bool favoritesOnly;

    /// <summary>Opens the slideshow with the same group, assignment, status and favorites choice.</summary>
    private string SlideshowHref
    {
        get
        {
            var query = new List<string>();
            if (Guid.TryParse(selectedGroupId, out var groupId)) query.Add($"group={groupId}");
            if (int.TryParse(selectedAssignmentNumber, out var number)) query.Add($"assignment={number}");
            if (Enum.TryParse<SubmissionStatus>(selectedStatus, out var status)) query.Add($"status={status}");
            if (favoritesOnly) query.Add("favorites=true");
            return query.Count == 0 ? "slideshow" : $"slideshow?{string.Join('&', query)}";
        }
    }

    private List<Submission> VisibleSubmissions => favoritesOnly ? submissions.Where(Favorites.IsFavorite).ToList() : submissions;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Favorites.Changed += OnFavoritesChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Favorites.EnsureLoadedAsync();
        }
    }

    private void OnFavoritesChanged() => InvokeAsync(StateHasChanged);

    protected override void Dispose(bool disposing)
    {
        Favorites.Changed -= OnFavoritesChanged;
        base.Dispose(disposing);
    }

    private bool HasActiveFilters =>
        favoritesOnly
        || !string.IsNullOrWhiteSpace(filter.SearchTerm)
        || !string.IsNullOrWhiteSpace(filter.Reviewer)
        || !string.IsNullOrEmpty(selectedGroupId)
        || !string.IsNullOrEmpty(selectedAssignmentNumber)
        || !string.IsNullOrEmpty(selectedStatus);

    private static string GetStoredFileName(Submission sub) =>
        string.IsNullOrWhiteSpace(sub.StoragePath) ? sub.FileName : Path.GetFileName(sub.StoragePath);
}
