@page "/assignments"
@rendermode InteractiveServer
@inherits LiveComponentBase
@inject NavigationManager Navigation

<PageTitle>Opdrachten - DU Review</PageTitle>

<PageHeader Title="Opdrachten" Subtitle="Open een opdracht om de inzendingen van alle groepen te vergelijken." />

<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="search-box number-search">
            <i class="bi bi-search"></i>
            <input type="search" class="form-control form-control-dark" placeholder="Nummer, letter of titel"
                   @bind="numberSearch" @bind:event="oninput" />
        </div>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="onlySubmitted" @bind="onlyWithSubmissions" />
            <label class="form-check-label text-secondary small" for="onlySubmitted">Alleen opdrachten met inzendingen</label>
        </div>
    </div>

    @if (rows == null)
    {
        <div class="empty-state">
            <div class="spinner-border text-success" role="status"></div>
        </div>
    }
    else if (!VisibleRows.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            Geen opdrachten gevonden.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Opdracht</th>
                        <th class="text-center">Punten</th>
                        <th class="text-center">Groepen</th>
                        <th class="text-center">Open</th>
                        <th class="text-center">Goedgekeurd</th>
                        <th class="text-center">Awesome</th>
                        <th class="text-center">Afgekeurd</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in VisibleRows)
                    {
                        <tr class="clickable-row" @onclick="@(() => Navigation.NavigateTo($"assignments/{row.Code}"))">
                            <td>
                                <a href="assignments/@row.Code" class="fw-bold text-white text-decoration-none hover-underline">#@row.Code</a>
                                @if (row.Title != null)
                                {
                                    <span class="assignment-title text-white-50 small ms-1">@row.Title</span>
                                }
                            </td>
                            <td class="text-center text-white-50">
                                @row.StandardPoints <span class="text-muted">/</span> <span class="text-awesome">@row.AwesomePoints</span>
                            </td>
                            <td class="text-center text-white">@row.Stats.TotalSubmissions <span class="text-muted">/ @groupCount</span></td>
                            <td class="text-center"><span class="badge badge-pending">@row.Stats.PendingCount</span></td>
                            <td class="text-center"><span class="badge badge-approved">@row.Stats.ApprovedCount</span></td>
                            <td class="text-center"><span class="badge badge-awesome">@row.Stats.AwesomeCount</span></td>
                            <td class="text-center"><span class="badge badge-rejected">@row.Stats.RejectedCount</span></td>
                            <td class="text-end text-secondary"><i class="bi bi-chevron-right"></i></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small mt-2">Punten: standaard / awesome. Aantallen zijn per groep; herinzendingen tellen één keer.</div>
    }
</div>

@code {
    private sealed record Row(string Code, string? Title, int StandardPoints, int AwesomePoints, AssignmentStatistic Stats);

    private List<Row>? rows;
    private int groupCount;
    private string? numberSearch;
    private bool onlyWithSubmissions = true;

    private IEnumerable<Row> VisibleRows => (rows ?? new List<Row>())
        .Where(r => !onlyWithSubmissions || r.Stats.TotalSubmissions > 0)
        .Where(r => Matches(r, numberSearch?.Trim()));

    /// <summary>A code starting with the search ("1" finds 1, 12, 100; "a" finds A), or a title containing it.</summary>
    private static bool Matches(Row row, string? search) =>
        string.IsNullOrEmpty(search)
        || row.Code.StartsWith(search.TrimStart('#'), StringComparison.OrdinalIgnoreCase)
        || (row.Title?.Contains(search, StringComparison.CurrentCultureIgnoreCase) ?? false);

    protected override Task OnInitializedAsync() => ReloadAsync();

    protected override async Task LoadAsync(IServiceProvider services)
    {
        var stats = await services.GetRequiredService<ISubmissionRepository>().GetStatisticsAsync();
        var assignments = (await services.GetRequiredService<IAssignmentRepository>().GetAllAsync()).ToDictionary(a => a.Code);
        groupCount = (await services.GetRequiredService<IGroupRepository>().GetAllAsync()).Count;

        rows = stats.AssignmentStatistics
            .Select(s => new Row(
                s.AssignmentCode,
                assignments.GetValueOrDefault(s.AssignmentCode)?.Title,
                assignments.GetValueOrDefault(s.AssignmentCode)?.StandardPoints ?? 0,
                assignments.GetValueOrDefault(s.AssignmentCode)?.AwesomePoints ?? 0,
                s))
            .OrderBy(r => r.Code, AssignmentCode.Comparer)
            .ToList();
    }
}
