@page "/avonturiers/rondes"
@rendermode InteractiveServer
@inject RuntimeSettingsService Runtime

<PageTitle>Rondes Avonturiers - DU Review</PageTitle>

<PageHeader Title="Rondes en berichten" Subtitle="De themarondes en wat de bot in de Avonturiers-kanalen plaatst. Aanpassen kan een beheerder." />
<AdventurersTabs />

@if (!Runtime.AdventurersEnabled)
{
    <AdventurersOff />
}
else
{
    <div class="row g-4">
        <div class="col-12"><RoundsPanel /></div>
        <div class="col-12"><RoundPostsPanel /></div>
        <div class="col-lg-4">
            <div class="glass-panel p-4 h-100">
                <h2 class="panel-title">Opening van een ronde</h2>
                <SlackTextEditor Kind="SlackText.RoundOpen" Label="de opening" Rows="5" Placeholders="{round}, {themes}, {start}, {end}, {message}" />
            </div>
        </div>
        <div class="col-lg-4">
            <div class="glass-panel p-4 h-100">
                <h2 class="panel-title">Sluiting van een ronde</h2>
                <SlackTextEditor Kind="SlackText.RoundClose" Label="de sluiting" Rows="5" Placeholders="{round}, {themes}, {end}" />
            </div>
        </div>
        <div class="col-lg-4">
            <div class="glass-panel p-4 h-100">
                <h2 class="panel-title">Uitslag van een ronde</h2>
                <SlackTextEditor Kind="SlackText.RoundResult" Label="de uitslag" Rows="5" Placeholders="{round}, {ranking}" />
            </div>
        </div>
        <div class="col-lg-6"><AdventurersAnnouncementPanel /></div>
        <div class="col-lg-6"><AdventurersAnnouncementPanel Final="true" /></div>
    </div>
}
