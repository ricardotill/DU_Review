@page "/simulator"
@rendermode InteractiveServer
@inject IGroupRepository GroupRepository
@inject ISubmissionRepository SubmissionRepository
@inject ISlackEventDispatcher Dispatcher
@inject NavigationManager Navigation
@inject IOptions<ScoutingSettings> ScoutingOptions
@inject RuntimeSettingsService Runtime

<PageTitle>Slack-simulator - DU Review</PageTitle>

@if (!SimulationEnabled)
{
    <PageHeader Title="Slack-simulator" />
    <div class="glass-panel empty-state">
        <i class="bi bi-slash-circle"></i>
        De simulator is alleen beschikbaar als <code>Scouting:Slack:SimulationMode</code> aan staat.
    </div>
}
else
{

<PageHeader Title="Slack-simulator" Subtitle="Stuur testuploads en reacties alsof ze uit Slack komen. Alleen beschikbaar in simulatiemodus.">
    <Actions>
        <a href="submissions" class="btn btn-scout-secondary d-flex align-items-center gap-2">
            <i class="bi bi-folder2-open"></i>
            <span>Inzendingen</span>
        </a>
    </Actions>
</PageHeader>

<div class="row g-4">
    <!-- Simulator 1: Post Message with Media -->
    <div class="col-lg-6">
        <div class="glass-panel p-4 h-100">
            <h2 class="panel-title">
                <i class="bi bi-chat-left-dots-fill text-info"></i> Bestand uploaden
            </h2>
            <p class="text-secondary small mb-3">
                Een scout plaatst een bestand in het kanaal van de groep.
            </p>

            <div class="mb-3">
                <label class="form-label text-secondary small fw-semibold">Groepskanaal</label>
                <select class="form-select form-select-dark" @bind="selectedChannel">
                    @foreach (var g in groups)
                    {
                        <option value="@g.SlackChannelId">@g.Name (#@g.SlackChannelId)</option>
                        @if (Runtime.AdventurersEnabled && !string.IsNullOrWhiteSpace(g.AdventurersSlackChannelId))
                        {
                            <option value="@g.AdventurersSlackChannelId">@g.Name Avonturiers (#@g.AdventurersSlackChannelId)</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label text-secondary small fw-semibold">Scout</label>
                <input type="text" class="form-control form-control-dark" placeholder="bijv. Robin_Leiding" @bind="submitterName" />
            </div>

            <div class="mb-3">
                <label class="form-label text-secondary small fw-semibold">Bericht</label>
                <textarea class="form-control form-control-dark" rows="3" placeholder="bijv. Opdracht 4: Onze patrouille heeft de post bereikt!" @bind="messageText"></textarea>
                <div class="form-text text-muted">
                    Zet het opdrachtnummer erin, zoals <code>Opdracht 4</code>, <code>#4</code> of <code>A4</code>.
                    @if (Runtime.AdventurersEnabled)
                    {
                        <span>In een Avonturiers-kanaal: <code>Locatie 7</code>, <code>L7</code> of <code>#7</code> voor een check-in, <code>Opdracht 3</code>, <code>Thema 3</code> of <code>T3</code> voor een half-uur opdracht.</span>
                    }
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label text-secondary small fw-semibold">Bestandsnaam</label>
                <div class="input-group">
                    <input type="text" class="form-control form-control-dark" placeholder="foto_tent.jpg" @bind="fileName" />
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Voorbeelden
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><a class="dropdown-item" href="javascript:void(0)" @onclick='() => SetPreset("kampvuur.jpg", "Opdracht 1: Ons vuurtje brandt!")'>🔥 Kampvuurfoto (.jpg)</a></li>
                        <li><a class="dropdown-item" href="javascript:void(0)" @onclick='() => SetPreset("vlaggenmast.png", "#2 Vlaggenmast staat fier overeind.")'>🚩 Vlaggenmast (.png)</a></li>
                        <li><a class="dropdown-item" href="javascript:void(0)" @onclick='() => SetPreset("knopen_demo.mp4", "Opdracht 3: Bekijk de video van de mastworp")'>🎥 Knopendemo (.mp4)</a></li>
                        <li><a class="dropdown-item" href="javascript:void(0)" @onclick='() => SetPreset("verslag_tocht.pdf", "A4 Verslag van de oriëntatietocht")'>📄 Verslag (.pdf)</a></li>
                        @if (Runtime.AdventurersEnabled)
                        {
                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick='() => SetPreset("checkin.jpg", "Locatie 7, iedereen staat erop!")'>📍 Check-in (Avonturiers)</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" @onclick='() => SetPreset("halfuur.jpg", "Opdracht 3")'>📸 Half-uur opdracht (Avonturiers)</a></li>
                        }
                    </ul>
                </div>
            </div>

            <button class="btn btn-scout-primary w-100 py-2 d-flex justify-content-center align-items-center gap-2" @onclick="PostMessageAsync" disabled="@isPosting">
                @if (isPosting)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>Verwerken…</span>
                }
                else
                {
                    <i class="bi bi-send-fill"></i>
                    <span>Upload plaatsen</span>
                }
            </button>
        </div>
    </div>

    <!-- Simulator 2: Add Emoji Reaction -->
    <div class="col-lg-6">
        <div class="glass-panel p-4 h-100">
            <h2 class="panel-title">
                <i class="bi bi-emoji-smile-fill text-warning"></i> Reageren als jurylid
            </h2>
            <p class="text-secondary small mb-3">
                Een jurylid reageert op een inzending. Alleen gebruikers die als jurylid zijn ingesteld, tellen.
            </p>

            <div class="mb-3">
                <label class="form-label text-secondary small fw-semibold">Inzending</label>
                <select class="form-select form-select-dark" @bind="selectedSubmissionId">
                    <option value="">Kies een inzending</option>
                    @foreach (var s in pendingSubmissions)
                    {
                        <option value="@s.Id">
                            @(s.Group?.Name ?? "Groep"): #@s.CodeLabel - @s.FileName (@s.Status.StatusLabel())
                        </option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label text-secondary small fw-semibold">Jurylid</label>
                <input type="text" class="form-control form-control-dark" list="configured-reviewers" placeholder="Slack-gebruiker" @bind="reviewerName" />
                <datalist id="configured-reviewers">
                    @foreach (var reviewer in Runtime.AllReviewers)
                    {
                        <option value="@reviewer">@Runtime.DisplayName(reviewer)</option>
                    }
                </datalist>
            </div>

            <div class="mb-4">
                <label class="form-label text-secondary small fw-semibold">Emoji</label>
                <div class="d-grid gap-2">
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-success flex-fill py-2 text-start @(selectedEmoji == "thumbsup" ? "active" : "")" @onclick='() => selectedEmoji = "thumbsup"'>
                            👍 <strong>thumbsup</strong> <span class="small text-muted d-block">Goedkeuren (+1)</span>
                        </button>
                        <button class="btn btn-outline-primary flex-fill py-2 text-start @(selectedEmoji == "heart" ? "active" : "")" @onclick='() => selectedEmoji = "heart"'>
                            💖 <strong>heart</strong> <span class="small text-muted d-block">Awesome</span>
                        </button>
                        <button class="btn btn-outline-danger flex-fill py-2 text-start @(selectedEmoji == "x" ? "active" : "")" @onclick='() => selectedEmoji = "x"'>
                            ❌ <strong>x</strong> <span class="small text-muted d-block">Afkeuren</span>
                        </button>
                    </div>
                </div>
            </div>

            <button class="btn btn-scout-secondary w-100 py-2 d-flex justify-content-center align-items-center gap-2" @onclick="PostReactionAsync" disabled="@(isReacting || string.IsNullOrEmpty(selectedSubmissionId))">
                @if (isReacting)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>Verwerken…</span>
                }
                else
                {
                    <i class="bi bi-hand-thumbs-up"></i>
                    <span>Emoji :@selectedEmoji: plaatsen</span>
                }
            </button>
        </div>
    </div>
</div>

<!-- Live Execution Feed -->
<div class="glass-panel p-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 fw-bold text-white mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-terminal-fill text-success"></i> Log
        </h2>
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => logs.Clear()">Wissen</button>
    </div>

    <div class="p-3 rounded-3 font-monospace small" style="background: rgba(0,0,0,0.5); min-height: 180px; max-height: 350px; overflow-y: auto; border: 1px solid var(--border-color);">
        @if (logs.Count == 0)
        {
            <div class="text-muted">Nog niets. Plaats hierboven een upload of een emoji.</div>
        }
        @foreach (var entry in logs)
        {
            <div class="mb-1 text-white-50">
                <span class="text-muted">[@entry.Timestamp.ToString("HH:mm:ss")]</span>
                <span class="@entry.CssClass fw-bold">@entry.Level</span>
                <span>@entry.Message</span>
            </div>
        }
    </div>
</div>

}

@code {
    // The simulator can post review reactions, so it must not be reachable against a live Slack workspace
    private bool SimulationEnabled => ScoutingOptions.Value.Slack.SimulationMode;

    private IReadOnlyList<Group> groups = new List<Group>();
    private List<Submission> pendingSubmissions = new();

    private string selectedChannel = "";
    private string submitterName = "Tim_Scout";
    private string messageText = "Opdracht 3: We hebben de knopen succesvol afgerond!";
    private string fileName = "knopen_foto.jpg";

    private string selectedSubmissionId = "";
    private string reviewerName = "Jury_Eva";
    private string selectedEmoji = "thumbsup";

    private bool isPosting = false;
    private bool isReacting = false;
    private List<LogEntry> logs = new();

    protected override async Task OnInitializedAsync()
    {
        groups = await GroupRepository.GetAllAsync();
        if (groups.Count > 0)
        {
            selectedChannel = groups[0].SlackChannelId;
        }

        await RefreshPendingSubmissionsAsync();
    }

    private async Task RefreshPendingSubmissionsAsync()
    {
        var all = await SubmissionRepository.SearchSubmissionsAsync(new SubmissionFilter());
        pendingSubmissions = all.Where(s => s.Status == SubmissionStatus.Pending).ToList();
        if (pendingSubmissions.Count > 0 && string.IsNullOrEmpty(selectedSubmissionId))
        {
            selectedSubmissionId = pendingSubmissions[0].Id.ToString();
        }
    }

    private void SetPreset(string file, string text)
    {
        fileName = file;
        messageText = text;
    }

    // The action buttons only render in simulation mode
    private async Task PostMessageAsync()
    {
        isPosting = true;
        var ts = $"{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}.{DateTimeOffset.UtcNow.Millisecond:D3}";

        var payload = new SlackEventItemDto
        {
            Type = "message",
            Channel = selectedChannel,
            User = submitterName,
            Text = messageText,
            Ts = ts,
            Files = new List<SlackFileItemDto>
            {
                new()
                {
                    Id = $"F_{Guid.NewGuid():N}",
                    Name = fileName,
                    Title = fileName,
                    Size = 1024 * 142,
                    Filetype = Path.GetExtension(fileName).Trim('.'),
                    Mimetype = fileName.EndsWith(".pdf") ? "application/pdf" : fileName.EndsWith(".mp4") ? "video/mp4" : "image/jpeg",
                    UrlPrivateDownload = $"sim://{fileName}"
                }
            }
        };

        AddLog("INFO", $"Bericht verstuurd: kanaal={selectedChannel}, scout={submitterName}, bestand={fileName}", "text-info");

        var result = (ProcessSlackMessageResult?)await Dispatcher.DispatchAsync(Envelope(payload));
        if (result is { Success: true })
        {
            AddLog("OK", $"Verwerkt: bestand opgeslagen in de groepsmap, inzending-ID(s): {string.Join(", ", result.CreatedSubmissionIds)}", "text-success");
        }
        else
        {
            AddLog("LET OP", $"Resultaat: {result?.Message}", "text-warning");
        }

        await RefreshPendingSubmissionsAsync();
        isPosting = false;
    }

    private async Task PostReactionAsync()
    {
        // The button is disabled until a submission is selected
        var subId = Guid.Parse(selectedSubmissionId);
        isReacting = true;

        var sub = await SubmissionRepository.GetByIdAsync(subId);
        if (sub == null)
        {
            AddLog("FOUT", $"Inzending {subId} niet gevonden", "text-danger");
            isReacting = false;
            return;
        }

        var payload = new SlackEventItemDto
        {
            Type = "reaction_added",
            Reaction = selectedEmoji,
            User = reviewerName,
            Item = new SlackReactionTargetDto
            {
                Type = "message",
                Channel = sub.SlackChannelId,
                Ts = sub.SlackMessageId
            }
        };

        AddLog("INFO", $"Emoji ':{selectedEmoji}:' van {reviewerName} verstuurd op bericht {sub.SlackMessageId}", "text-info");

        var result = (ProcessSlackReactionResult?)await Dispatcher.DispatchAsync(Envelope(payload));
        if (result is { Success: true })
        {
            AddLog("OK", $"Emoji verwerkt. Status is nu {result.NewStatus?.StatusLabel()}. Het bestand is verplaatst.", "text-success");
        }
        else
        {
            AddLog("LET OP", $"Resultaat: {result?.Message}", "text-warning");
        }

        await RefreshPendingSubmissionsAsync();
        isReacting = false;
    }

    // Through the dispatcher, like real Slack events, so they also appear on the events page
    private static SlackEventEnvelopeDto Envelope(SlackEventItemDto ev) => new() { Type = "event_callback", Event = ev };

    private void AddLog(string level, string message, string cssClass)
    {
        logs.Insert(0, new LogEntry(DateTimeOffset.UtcNow, level, message, cssClass));
    }

    public record LogEntry(DateTimeOffset Timestamp, string Level, string Message, string CssClass);
}
