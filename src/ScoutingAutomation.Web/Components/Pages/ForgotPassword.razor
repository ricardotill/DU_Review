@page "/wachtwoord-vergeten"
@layout LoginLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject AccountService Accounts
@inject LoginAttemptLimiter Limiter
@inject IOptions<ScoutingSettings> Options

<PageTitle>Wachtwoord vergeten - DU Review</PageTitle>

<h1 class="h5 text-white text-center mb-3">Wachtwoord vergeten</h1>

@if (sent)
{
    <div class="alert alert-success small" role="status">
        Als er een account is met dit adres, krijg je binnen een paar minuten een mail met een link om een nieuw wachtwoord te kiezen.
        Geen mail? Kijk in je spam, of vraag de organisatie om een nieuwe link.
    </div>
}
else
{
    <p class="text-secondary small">Vul het e-mailadres van je account in. Je krijgt een mail met een link om een nieuw wachtwoord te kiezen.</p>
    <EditForm Model="Input" method="post" OnSubmit="SendAsync" FormName="forgot-password">
        <InputText type="email" class="form-control form-control-dark mb-2" @bind-Value="Input.Email"
                   placeholder="E-mailadres" autocomplete="username" aria-label="E-mailadres" autofocus />
        @if (error != null)
        {
            <div class="text-danger small mb-2" role="alert">@error</div>
        }
        <button type="submit" class="btn btn-scout-primary w-100">Stuur een link</button>
    </EditForm>
}

<p class="text-center small mt-3 mb-0"><a href="login">Terug naar inloggen</a></p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private EmailInput Input { get; set; } = default!;

    private bool sent;
    private string? error;

    protected override void OnInitialized() => Input ??= new();

    private async Task SendAsync()
    {
        // Each request mails someone: counted like a failed login, so the form cannot be used to flood a mailbox
        var client = HttpContext.Connection.RemoteIpAddress?.ToString() ?? "unknown";
        if (!Limiter.TryAttempt(client))
        {
            error = "Te veel aanvragen. Wacht een minuut en probeer het opnieuw.";
            return;
        }

        await Accounts.SendPasswordResetAsync(Input.Email, BaseUrl.Of(Options.Value, HttpContext.Request));
        sent = true;
    }

    private sealed class EmailInput
    {
        public string? Email { get; set; }
    }
}
