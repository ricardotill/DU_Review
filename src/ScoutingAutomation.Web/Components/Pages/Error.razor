@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>Fout - DU Review</PageTitle>

<div class="glass-panel empty-state">
    <i class="bi bi-exclamation-octagon text-danger"></i>
    <h1 class="h4 text-white">Er ging iets mis</h1>
    <p class="mb-3">Er is een fout opgetreden bij het verwerken van je verzoek.</p>
    @if (ShowRequestId)
    {
        <p class="small">Verzoek-ID: <code>@RequestId</code></p>
    }
    <p class="small text-muted">
        Start de app met <code>ASPNETCORE_ENVIRONMENT=Development</code> voor details over de fout. Zet dit nooit aan in productie.
    </p>
    <a href="" class="btn btn-scout-secondary">Naar het dashboard</a>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
