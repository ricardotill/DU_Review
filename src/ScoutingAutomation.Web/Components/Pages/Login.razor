@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject SignInManager<AppUser> SignIn
@inject UserManager<AppUser> Users
@inject LoginAttemptLimiter Limiter
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<PageTitle>Inloggen - DU Review</PageTitle>

<h1 class="h5 text-white text-center mb-3">Inloggen</h1>

<EditForm Model="Input" method="post" OnSubmit="LogInAsync" FormName="login">
    <InputText type="text" inputmode="email" class="form-control form-control-dark mb-2" @bind-Value="Input.Email"
               placeholder="E-mailadres" autocomplete="username" aria-label="E-mailadres" autofocus />
    <InputText type="password" class="form-control form-control-dark mb-2" @bind-Value="Input.Password"
               placeholder="Wachtwoord" autocomplete="current-password" aria-label="Wachtwoord" />
    @if (error != null)
    {
        <div class="text-danger small mb-2" role="alert">@error</div>
    }
    <button type="submit" class="btn btn-scout-primary w-100">Inloggen</button>
</EditForm>

<p class="text-center small mt-3 mb-1"><a href="wachtwoord-vergeten">Wachtwoord vergeten?</a></p>
<p class="text-muted small text-center mb-0">Nog geen account? Vraag de organisatie om er een voor je te maken.</p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = default!;

    private string? error;

    private const string WrongLogin = "Dit e-mailadres of wachtwoord klopt niet.";

    // Already logged in, for example in another tab of this browser
    private bool AlreadyLoggedIn => HttpMethods.IsGet(HttpContext.Request.Method) && HttpContext.User.Identity?.IsAuthenticated == true;

    protected override void OnInitialized()
    {
        Input ??= new();
        if (AlreadyLoggedIn) Navigation.NavigateTo(AppAuth.StartPage(HttpContext.User, ReturnUrl));
    }

    private async Task LogInAsync()
    {
        var client = HttpContext.Connection.RemoteIpAddress?.ToString() ?? "unknown";
        // Counted before the password is checked: attempts sent at the same moment cannot all get through.
        // Per address, on top of the lockout per account, so guessing across many accounts is slowed down too.
        if (!Limiter.TryAttempt(client))
        {
            error = "Te veel mislukte pogingen. Wacht een minuut en probeer het opnieuw.";
            return;
        }

        var login = Input.Email?.Trim();
        // By address; the account "admin" made without a first admin address (AccountsInitializer) logs in by its name
        var user = string.IsNullOrEmpty(login) ? null : await Users.FindByEmailAsync(login) ?? await Users.FindByNameAsync(login);
        if (user == null || user.IsDisabled)
        {
            // The same answer as a wrong password: the page does not tell which addresses have an account
            error = WrongLogin;
            return;
        }

        var result = await SignIn.PasswordSignInAsync(user, Input.Password ?? "", isPersistent: true, lockoutOnFailure: true);
        if (result.IsLockedOut)
        {
            error = "Te veel verkeerde wachtwoorden voor dit account. Probeer het over een kwartier opnieuw, of kies een nieuw wachtwoord via \"Wachtwoord vergeten\".";
            return;
        }

        if (!result.Succeeded)
        {
            error = WrongLogin;
            return;
        }

        Limiter.Succeeded(client);
        user.LastLoginAt = DateTimeOffset.UtcNow;
        await Users.UpdateAsync(user);
        WarnIfPlainHttp(user);

        // A group starts on its dashboard and the beamer on the scoreboard; a return link only leads jury pages
        // The same claims as the login cookie: a team without a group in the active edition starts on its earlier editions
        var principal = await SignIn.CreateUserPrincipalAsync(user);
        Navigation.NavigateTo(AppAuth.StartPage(principal, ReturnUrl));
    }

    // Groups should use the HTTPS address: over plain HTTP the password and the login cookie cross the venue Wi-Fi readable
    private void WarnIfPlainHttp(AppUser user)
    {
        var remote = HttpContext.Connection.RemoteIpAddress;
        if (HttpContext.Request.IsHttps || remote == null || System.Net.IPAddress.IsLoopback(remote)) return;

        Logger.LogWarning("{Account} logged in over plain HTTP from {RemoteIp}; use the HTTPS address", user.Email, remote);
    }

    private sealed class LoginInput
    {
        public string? Email { get; set; }
        public string? Password { get; set; }
    }
}
