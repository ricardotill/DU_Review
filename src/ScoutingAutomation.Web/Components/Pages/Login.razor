@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject AccessKeyService Keys
@inject LoginAttemptLimiter Limiter
@inject NavigationManager Navigation
@inject IGroupRepository Groups
@inject ILogger<Login> Logger

<PageTitle>Inloggen - DU Review</PageTitle>

<h1 class="h5 text-white text-center mb-3">Vul de toegangssleutel in</h1>

<EditForm Model="Input" method="post" OnSubmit="LogInAsync" FormName="login">
    <InputText type="password" class="form-control form-control-dark mb-2" @bind-Value="Input.Key"
               placeholder="XXXX-XXXX-XXXX-XXXX" autocomplete="current-password" aria-label="Toegangssleutel" autofocus />
    @if (error != null)
    {
        <div class="text-danger small mb-2" role="alert">@error</div>
    }
    <button type="submit" class="btn btn-scout-primary w-100">Inloggen</button>
</EditForm>

<p class="text-muted small text-center mt-3 mb-0">Jury: vraag de organisatie om de toegangssleutel. Groepen: gebruik de groepssleutel die jullie van de organisatie kregen.</p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = new();

    private string? error;

    // Already logged in, for example after a key change in another tab of this browser
    private bool AlreadyLoggedIn => HttpMethods.IsGet(HttpContext.Request.Method) && HttpContext.User.Identity?.IsAuthenticated == true;

    protected override void OnInitialized()
    {
        if (AlreadyLoggedIn) Navigation.NavigateTo(KeyAuth.SafeReturnUrl(ReturnUrl));
    }

    private async Task LogInAsync()
    {
        var client = HttpContext.Connection.RemoteIpAddress?.ToString() ?? "unknown";
        // Counted before the key is checked: attempts sent at the same moment cannot all get through
        if (!Limiter.TryAttempt(client))
        {
            error = "Te veel verkeerde sleutels. Wacht een minuut en probeer het opnieuw.";
            return;
        }

        var admin = Keys.IsAdminKey(Input.Key);
        if (admin || Keys.IsAccessKey(Input.Key))
        {
            Limiter.Succeeded(client);
            await KeyAuth.SignInAsync(HttpContext, Keys, admin);
            Navigation.NavigateTo(KeyAuth.SafeReturnUrl(ReturnUrl));
            return;
        }

        // A key of a group that is no longer in the settings does not log in
        if (Keys.FindGroupChannel(Input.Key) is { } channel && await Groups.GetBySlackChannelIdAsync(channel) is { } group)
        {
            Limiter.Succeeded(client);
            WarnIfPlainHttp(group.Name);
            await KeyAuth.SignInAsync(HttpContext, KeyAuth.CreateGroupPrincipal(Keys, group.Id, group.SlackChannelId, group.Name));
            // A return link from a jury page would only lead to "no access": a group starts on its dashboard
            Navigation.NavigateTo("/");
            return;
        }

        error = "Deze sleutel klopt niet.";
    }

    // Groups should use the HTTPS address: over plain HTTP the key and the login cookie cross the venue Wi-Fi readable
    private void WarnIfPlainHttp(string groupName)
    {
        var remote = HttpContext.Connection.RemoteIpAddress;
        if (HttpContext.Request.IsHttps || remote == null || System.Net.IPAddress.IsLoopback(remote)) return;

        Logger.LogWarning("Group {Group} logged in over plain HTTP from {RemoteIp}; give groups the HTTPS address", groupName, remote);
    }

    private sealed class LoginInput
    {
        public string? Key { get; set; }
    }
}
