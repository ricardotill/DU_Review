@page "/messages"
@rendermode InteractiveServer
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject ISlackClient Slack

<PageTitle>Bericht sturen - DU Review</PageTitle>

<PageHeader Title="Bericht sturen" Subtitle="Plaats een bericht van de bot in de Slack-kanalen van de groepen." />

@if (groups == null)
{
    <div class="empty-state">
        <div class="spinner-border text-success" role="status"></div>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="glass-panel p-4">
                <h2 class="panel-title"><i class="bi bi-chat-text-fill text-info"></i> Bericht</h2>
                <SlackComposer @ref="composer" Label="Bericht voor de groepen" Rows="6" TextChanged="OnTextChanged" />
                <div class="stat-caption mt-2">Opmaak en emoji komen zo in Slack. Het bericht verschijnt als de bot.</div>

                <div class="mt-3">
                    @if (picture == null)
                    {
                        <label class="btn btn-sm btn-scout-secondary add-picture @(posting || loadingPicture ? "disabled" : "")">
                            <i class="bi bi-image me-1"></i> Foto toevoegen
                            <InputFile class="d-none" accept="image/*" OnChange="OnPictureChosen" disabled="@(posting || loadingPicture)" />
                        </label>
                        @if (loadingPicture)
                        {
                            <div class="spinner-border spinner-border-sm text-success ms-2" role="status"><span class="visually-hidden">Foto laden</span></div>
                        }
                    }
                    else
                    {
                        <div class="message-picture inset-panel d-flex align-items-center gap-3 p-2">
                            @if (thumbnail != null)
                            {
                                <img src="@thumbnail" alt="Voorbeeld van @picture.FileName" />
                            }
                            else
                            {
                                <i class="bi bi-image fs-2 text-secondary"></i>
                            }
                            <div class="min-w-0 flex-grow-1">
                                <div class="text-white small text-truncate">@picture.FileName</div>
                                <div class="stat-caption">@FormatSize(picture.Size)</div>
                            </div>
                            <button type="button" class="btn btn-sm btn-link text-secondary remove-picture" aria-label="Foto weghalen" disabled="@posting" @onclick="RemovePicture">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }
                </div>

                @if (error != null)
                {
                    <div class="text-danger small mt-2">@error</div>
                }

                <div class="small mt-3">
                    @if (!Slack.IsConnected)
                    {
                        <i class="bi bi-plug text-warning me-1"></i><span class="text-white-50">Niet verbonden met Slack (<code>SimulationMode</code> aan of geen bot-token): er wordt niets geplaatst.</span>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                    @if (confirming)
                    {
                        <button type="button" class="btn btn-scout-primary send-message" disabled="@(!CanSend)" @onclick="Send">
                            <i class="bi bi-send-check me-1"></i> Zeker? Sturen naar @ChannelCount
                        </button>
                        <button type="button" class="btn btn-scout-secondary" disabled="@posting" @onclick="() => confirming = false">Annuleren</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-scout-primary send-message" disabled="@(!CanSend)" @onclick="() => confirming = true">
                            <i class="bi bi-send me-1"></i> Sturen naar @ChannelCount
                        </button>
                    }
                    @if (posting)
                    {
                        <div class="spinner-border spinner-border-sm text-success" role="status"><span class="visually-hidden">Bezig met sturen</span></div>
                    }
                </div>

                @if (results != null)
                {
                    <ul class="list-unstyled small d-flex flex-column gap-1 mt-3 mb-0 message-results">
                        @foreach (var result in results)
                        {
                            <li class="d-flex justify-content-between gap-2">
                                <span class="text-white">@result.GroupName</span>
                                @if (result.Error is { } failure)
                                {
                                    <span class="text-danger">Mislukt: <code>@failure</code></span>
                                }
                                else
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Geplaatst</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="glass-panel p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="panel-title mb-0"><i class="bi bi-people-fill text-success"></i> Groepen</h2>
                    <div class="d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-link text-secondary select-all" disabled="@posting" @onclick="SelectAll">Alles</button>
                        <button type="button" class="btn btn-sm btn-link text-secondary select-none" disabled="@posting" @onclick="() => Select(Array.Empty<Guid>())">Niets</button>
                    </div>
                </div>
                <div class="stat-caption mb-2">@selected.Count van @groups.Count groepen</div>

                @if (groups.Count == 0)
                {
                    <p class="text-muted small mb-0">Geen groepen ingesteld.</p>
                }
                <div class="d-flex flex-column gap-1">
                    @foreach (var group in groups)
                    {
                        var id = $"message-group-{group.Id}";
                        var hasChannel = !string.IsNullOrWhiteSpace(group.SlackChannelId);
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@id" checked="@selected.Contains(group.Id)"
                                   disabled="@(posting || !hasChannel)" @onchange="e => Toggle(group.Id, e.Value is true)" />
                            <label class="form-check-label text-white" for="@id">
                                @group.Name
                                @if (!hasChannel)
                                {
                                    <span class="text-muted small">(geen kanaal)</span>
                                }
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Only this group is selected at first, instead of all groups.</summary>
    [SupplyParameterFromQuery(Name = "group")]
    public Guid? GroupId { get; set; }

    private IReadOnlyList<Group>? groups;
    private HashSet<Guid> selected = new();
    private SlackComposer? composer;
    private IReadOnlyList<AnnouncementPostResult>? results;
    // On disk until it is sent: a picture of up to 20 MB per open tab would otherwise stay in the server's memory
    private PictureDraft? picture;
    private string? thumbnail;
    private bool loadingPicture;
    private string? error;
    private bool empty = true;
    private bool confirming;
    private bool posting;

    private bool CanSend => Slack.IsConnected && !posting && !loadingPicture && (!empty || picture != null) && selected.Count > 0;

    private string ChannelCount => selected.Count == 1 ? "1 kanaal" : $"{selected.Count} kanalen";

    protected override async Task OnInitializedAsync()
    {
        // A scope of its own: the tab's own database context would keep returning what it read first
        await using var scope = ScopeFactory.CreateAsyncScope();
        groups = (await scope.ServiceProvider.GetRequiredService<IGroupRepository>().GetAllAsync()).OrderBy(g => g.Name).ToList();
        if (GroupId is { } only && groups.Any(g => g.Id == only)) Select(new[] { only });
        else SelectAll();
    }

    private void SelectAll() => Select(groups!.Select(g => g.Id));

    private void Select(IEnumerable<Guid> ids)
    {
        var withChannel = groups!.Where(g => !string.IsNullOrWhiteSpace(g.SlackChannelId)).Select(g => g.Id).ToHashSet();
        selected = ids.Where(withChannel.Contains).ToHashSet();
        confirming = false;
    }

    private void Toggle(Guid id, bool on)
    {
        if (on) selected.Add(id);
        else selected.Remove(id);
        confirming = false;
    }

    private void OnTextChanged(string text)
    {
        empty = string.IsNullOrWhiteSpace(text);
        if (empty) confirming = false;
    }

    private async Task Send()
    {
        if (composer == null || !CanSend) return;

        // Before the first await, so a second click cannot send the message again
        posting = true;
        confirming = false;
        try
        {
            // Open to the jury, but not to a tab whose access key was regenerated in the meantime
            if (AuthState == null || (await AuthState).User.Identity?.IsAuthenticated != true)
            {
                error = "Je bent niet meer ingelogd. Laad de pagina opnieuw.";
                return;
            }

            var text = await composer.GetMrkdwnAsync();
            var attached = picture == null ? null : new MessagePicture(picture.FileName, await File.ReadAllBytesAsync(picture.Path));
            error = GroupMessageSender.Validate(text, attached);
            if (error != null) return;

            var sent = selected.ToList();
            await using (var scope = ScopeFactory.CreateAsyncScope())
            {
                results = await scope.ServiceProvider.GetRequiredService<GroupMessageSender>().PostAsync(text, sent, attached);
            }

            // Channels that have the message drop out, so sending again only retries the ones that failed
            var posted = groups!.Where(g => results.Any(r => r.Posted && r.ChannelId == g.SlackChannelId)).Select(g => g.Id);
            selected.ExceptWith(posted);
            if (results.All(r => r.Posted))
            {
                await composer.ClearAsync();
                RemovePicture();
                Select(sent);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException
                                       or IOException or System.Data.Common.DbException)
        {
            // What was posted already stays listed in the results; the page keeps working
            error = $"Versturen is mislukt: {ex.Message}";
        }
        finally
        {
            posting = false;
        }
    }

    private async Task OnPictureChosen(InputFileChangeEventArgs e)
    {
        var file = e.File;
        error = null;
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            error = "Kies een afbeelding.";
            return;
        }
        if (file.Size > GroupMessageSender.MaxPictureBytes)
        {
            error = $"De foto is te groot: maximaal {GroupMessageSender.MaxPictureBytes / 1024 / 1024} MB.";
            return;
        }

        loadingPicture = true;
        confirming = false;
        RemovePicture();
        var path = Path.Combine(Path.GetTempPath(), $"du-picture-{Guid.NewGuid():N}");
        try
        {
            await using (var stream = file.OpenReadStream(GroupMessageSender.MaxPictureBytes))
            await using (var target = File.Create(path))
            {
                await stream.CopyToAsync(target);
            }

            // The browser's content type is only a claim; the bytes must be a picture too
            var start = new byte[16];
            int read;
            await using (var check = File.OpenRead(path))
            {
                read = await check.ReadAtLeastAsync(start, start.Length, throwOnEndOfStream: false);
            }

            if (read == 0 || !GroupMessageSender.IsPicture(start.AsSpan(0, read)))
            {
                File.Delete(path);
                error = read == 0 ? "De foto is leeg." : "Kies een afbeelding.";
                return;
            }

            picture = new PictureDraft(GroupMessageSender.SafeFileName(file.Name), path, new FileInfo(path).Length);
            thumbnail = await ThumbnailAsync(file);
        }
        catch (Exception ex) when (ex is IOException or JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            error = $"De foto kon niet worden gelezen: {ex.Message}";
            if (picture?.Path != path) DeleteQuietly(path);
        }
        finally
        {
            loadingPicture = false;
        }
    }

    // The browser shrinks the picture, so only a small preview crosses the connection
    private static async Task<string?> ThumbnailAsync(IBrowserFile file)
    {
        try
        {
            var small = await file.RequestImageFileAsync("image/jpeg", 240, 240);
            using var content = new MemoryStream();
            await using var stream = small.OpenReadStream(2 * 1024 * 1024);
            await stream.CopyToAsync(content);
            return "data:image/jpeg;base64," + Convert.ToBase64String(content.ToArray());
        }
        catch (Exception)
        {
            // A format the browser cannot draw (such as HEIC) is still sent; there is just no preview
            return null;
        }
    }

    private void RemovePicture()
    {
        if (picture != null) DeleteQuietly(picture.Path);
        picture = null;
        thumbnail = null;
        confirming = false;
    }

    private static void DeleteQuietly(string path)
    {
        try
        {
            File.Delete(path);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            // A leftover in the temp folder; the system cleans that up
        }
    }

    public void Dispose() => RemovePicture();

    /// <summary>A chosen picture, kept in a temporary file until it is sent.</summary>
    private sealed record PictureDraft(string FileName, string Path, long Size);

    private static string FormatSize(long bytes) => bytes >= 1024 * 1024
        ? $"{bytes / 1024d / 1024d:0.0} MB"
        : $"{Math.Max(1, bytes / 1024)} kB";
}
