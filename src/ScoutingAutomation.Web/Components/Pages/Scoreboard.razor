@page "/scoreboard"
@rendermode InteractiveServer
@inherits LiveComponentBase
@inject IJSRuntime JS
@inject RuntimeSettingsService Runtime
@inject TimeProvider Time

<PageTitle>Scorebord - DU Review</PageTitle>

@* For a beamer: the submission totals, the scoreboard and the points over time, live. Full screen hides everything else. *@
<div class="beamer" @ref="beamer">
    <GameCountdown />
    <div class="beamer-header">
        <h1 class="beamer-title"><i class="bi bi-trophy-fill text-warning"></i> Scorebord</h1>
        <button class="btn btn-scout-secondary fullscreen" title="Volledig scherm" aria-label="Volledig scherm" @onclick="ToggleFullscreenAsync">
            <i class="bi bi-arrows-fullscreen"></i>
        </button>
    </div>

    @if (stats == null)
    {
        <div class="empty-state">
            <div class="spinner-border text-success" role="status"></div>
        </div>
    }
    else
    {
        <SubmissionTotals Stats="stats" />
        @* The jury can hide the standing here too, for when the groups can see the beamer *@
        @if (!clock!.IsHiddenOnBeamer)
        {
            <div class="beamer-body">
                <div class="beamer-board"><ScoreboardBoard Stats="stats" /></div>
                <div class="beamer-chart"><ScoreChart Stats="stats" Large="true" /></div>
            </div>
        }
        else if (clock.Interim is { } interim)
        {
            <div class="beamer-interim">
                <h2 class="h4 text-white-50 mb-3"><i class="bi bi-eye-slash"></i> Tussenstand van @interim.PublishedAt.ToGameTime().ToString("HH:mm")</h2>
                <ScoreboardBoard Stats="interim.ToStatistics()" />
            </div>
        }
        else
        {
            <div class="empty-state beamer-hidden">
                <i class="bi bi-eye-slash"></i>
                De stand is tijdelijk verborgen.
            </div>
        }
    }
</div>

@code {
    private SubmissionStatistics? stats;
    private ElementReference beamer;

    private StandingClock? clock;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        clock = new StandingClock(Runtime, Time, () => InvokeAsync(StateHasChanged));
    }

    protected override Task OnInitializedAsync() => ReloadAsync();

    protected override void Dispose(bool disposing)
    {
        clock?.Dispose();
        base.Dispose(disposing);
    }

    protected override async Task LoadAsync(IServiceProvider services)
    {
        stats = await services.GetRequiredService<ISubmissionRepository>().GetStatisticsAsync();
    }

    private async Task ToggleFullscreenAsync() => await JS.InvokeVoidAsync("duSlideshow.toggleFullscreen", beamer);
}
