@page "/groups/{Id:guid}"
@rendermode InteractiveServer
@inherits LiveComponentBase
@inject RuntimeSettingsService Runtime

<PageTitle>@(group?.Name ?? "Groep") - DU Review</PageTitle>

@if (!loaded)
{
    <div class="empty-state">
        <div class="spinner-border text-success" role="status"></div>
    </div>
}
else if (group == null)
{
    <PageHeader Title="Groep niet gevonden" BackHref="groups" BackText="Groepen" />
}
else
{
    <PageHeader Title="@group.Name" Subtitle="@group.Description" BackHref="groups" BackText="Groepen">
        <Details>
            <div class="d-flex gap-2 flex-wrap mt-2">
                @if (!string.IsNullOrWhiteSpace(group.Abbreviation))
                {
                    <span class="badge bg-secondary font-monospace">@group.Abbreviation</span>
                }
                <span class="badge assignment-badge">#@group.SlackChannelId</span>
            </div>
        </Details>
        <Actions>
            <a href="submissions?group=@group.Id" class="btn btn-scout-secondary d-flex align-items-center gap-2">
                <i class="bi bi-folder2-open"></i>
                <span>Alle uploads</span>
            </a>
            <a href="messages?group=@group.Id" class="btn btn-scout-secondary d-flex align-items-center gap-2 send-group-message">
                <i class="bi bi-megaphone"></i>
                <span>Bericht sturen</span>
            </a>
            <AuthorizeView Roles="@KeyAuth.AdminRole">
                <a href="/api/export/files.zip?status=approved&group=@group.Id" download class="btn btn-scout-secondary d-flex align-items-center gap-2" title="Goedgekeurde en awesome bestanden van deze groep">
                    <i class="bi bi-file-earmark-zip"></i>
                    <span>Downloaden</span>
                </a>
            </AuthorizeView>
        </Actions>
    </PageHeader>

    <!-- Totals for this group, resubmissions merged -->
    <div class="row g-3 mb-4">
        <div class="col-lg col-md-4 col-6">
            <div class="stat-card stat-total h-100">
                <div class="stat-label">Score</div>
                <div class="stat-value text-white">@(groupStats?.Score ?? 0)</div>
                <div class="stat-caption">Plaats @(groupStats?.Rank ?? 0) van @groupCount</div>
                @if (groupStats is { BonusTotal: > 0 } bonus)
                {
                    <div class="stat-caption score-breakdown">
                        @(bonus.Score - bonus.BonusTotal) opdrachten
                        @foreach (var category in Runtime.BonusCategories.Where(c => bonus.BonusPoints.GetValueOrDefault(c.Key) > 0))
                        {
                            <text> · @bonus.BonusPoints[category.Key] @category.Name</text>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="col-lg col-md-4 col-6">
            <div class="stat-card h-100" style="border-left: 4px solid var(--border-color);">
                <div class="stat-label">Ingezonden</div>
                <div class="stat-value text-white">@results.Count</div>
                <div class="stat-caption">van @assignmentCount opdrachten</div>
            </div>
        </div>
        <div class="col-lg col-md-4 col-6">
            <div class="stat-card stat-pending h-100">
                <div class="stat-label">Open</div>
                <div class="stat-value text-warning">@(groupStats?.PendingCount ?? 0)</div>
            </div>
        </div>
        <div class="col-lg col-md-4 col-6">
            <div class="stat-card stat-approved h-100">
                <div class="stat-label">Goedgekeurd</div>
                <div class="stat-value text-success">@(groupStats?.ApprovedCount ?? 0)</div>
            </div>
        </div>
        <div class="col-lg col-md-4 col-6">
            <div class="stat-card stat-awesome h-100">
                <div class="stat-label">Awesome</div>
                <div class="stat-value text-awesome">@(groupStats?.AwesomeCount ?? 0)</div>
            </div>
        </div>
        <div class="col-lg col-md-4 col-6">
            <div class="stat-card stat-rejected h-100">
                <div class="stat-label">Afgekeurd</div>
                <div class="stat-value text-danger">@(groupStats?.RejectedCount ?? 0)</div>
            </div>
        </div>
    </div>

    @if (unresolved.Count > 0)
    {
        <div class="glass-panel p-4 mb-4 unresolved-panel">
            <h2 class="panel-title"><i class="bi bi-exclamation-triangle-fill text-warning"></i> Uploads zonder opdracht (@unresolved.Count)</h2>
            <div class="d-flex flex-column gap-2">
                @foreach (var sub in unresolved)
                {
                    <a href="submissions/@sub.Id" class="inset-panel py-2 d-flex align-items-center gap-3 text-decoration-none">
                        <div class="file-icon"><FileIcon ContentType="@sub.ContentType" /></div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-semibold text-white text-truncate">@sub.FileName</div>
                            <div class="text-muted small text-truncate">@sub.UnresolvedReason</div>
                        </div>
                        <div class="text-muted small flex-shrink-0">@sub.CreatedAt.ToGameTime().ToString("g")</div>
                    </a>
                }
            </div>
        </div>
    }

    @if (stats != null)
    {
        <div class="glass-panel p-4 mb-4">
            <h2 class="panel-title"><i class="bi bi-graph-up text-info"></i> Punten in de loop van het spel</h2>
            <ScoreChart Stats="stats" Highlight="Id" />
        </div>
    }

    @if (Runtime.AdventurersEnabled)
    {
        <div class="glass-panel p-4 mb-4 adventurers-panel">
            <h2 class="panel-title"><i class="bi bi-compass-fill text-info"></i> Avonturiers</h2>
            <div class="small mb-3">
                @if (string.IsNullOrWhiteSpace(group!.AdventurersSlackChannelId))
                {
                    <span class="text-warning">Geen Avonturiers-kanaal ingesteld.</span>
                }
                @if (!string.IsNullOrWhiteSpace(group.MapToken))
                {
                    <span class="text-secondary">Kaart van de groep (zonder inloggen):</span>
                    <a href="@AdventurersLinks.MapPath(group.MapToken)" target="_blank" rel="noopener">@AdventurersLinks.MapPath(group.MapToken)</a>
                }
            </div>
            @if (adventurers.Count == 0)
            {
                <p class="text-muted small mb-0">Nog geen check-ins of thema-inzendingen.</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var sub in adventurers)
                    {
                        <a href="submissions/@sub.Id" class="inset-panel py-1 px-2 d-flex align-items-center gap-2 text-decoration-none small">
                            <span class="badge assignment-badge">#@sub.CodeLabel</span>
                            <StatusBadge Status="sub.Kind.Effective(sub.Status)" />
                            <span class="text-muted">@sub.CreatedAt.ToGameTime().ToString("HH:mm")</span>
                        </a>
                    }
                </div>
            }
        </div>
    }

    <!-- Per assignment -->
    <div class="glass-panel p-4">
        <h2 class="panel-title"><i class="bi bi-list-ol text-info"></i> Opdrachten</h2>

        @if (results.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                Deze groep heeft nog niets ingezonden.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="custom-table assignment-results">
                    <thead>
                        <tr>
                            <th>Opdracht</th>
                            <th>Status</th>
                            <th class="text-center">Punten</th>
                            <th class="text-center">Uploads</th>
                            <th>Laatste upload</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in results)
                        {
                            <tr>
                                <td>
                                    <a href="assignments/@result.Code" class="fw-bold text-white text-decoration-none hover-underline">#@result.Code</a>
                                    @if (result.Title != null)
                                    {
                                        <span class="assignment-title text-white-50 small ms-1">@result.Title</span>
                                    }
                                </td>
                                <td><StatusBadge Status="@result.BestStatus" /></td>
                                <td class="text-center fw-bold @(result.Points > 0 ? "text-white" : "text-muted")">
                                    @(result.Points > 0 ? $"+{result.Points}" : "0")
                                </td>
                                <td class="text-center text-white-50">@result.Uploads.Count</td>
                                <td class="text-white-50 small">@result.Uploads[0].CreatedAt.ToGameTime().ToString("g")</td>
                                <td class="text-end">
                                    <a href="submissions/@result.CountingSubmissionId" class="btn btn-sm btn-scout-secondary" title="Open de inzending die telt" aria-label="Inzending openen">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <AuthorizeView Roles="@KeyAuth.AdminRole">
        <div class="mt-4">
            <RebuildPanel Group="group" />
        </div>
    </AuthorizeView>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool loaded;
    private Group? group;
    private SubmissionStatistics? stats;
    private GroupStatistic? groupStats;
    private int groupCount;
    private int assignmentCount;
    private List<AssignmentResult> results = new();
    private List<Submission> unresolved = new();
    private List<Submission> adventurers = new();

    protected override Task OnParametersSetAsync() => ReloadAsync();

    protected override async Task LoadAsync(IServiceProvider services)
    {
        var groupRepository = services.GetRequiredService<IGroupRepository>();
        var submissionRepository = services.GetRequiredService<ISubmissionRepository>();

        group = await groupRepository.GetByIdAsync(Id);
        if (group == null)
        {
            loaded = true;
            return;
        }

        stats = await submissionRepository.GetStatisticsAsync();
        groupStats = stats.GroupStatistics.FirstOrDefault(g => g.GroupId == Id);
        groupCount = stats.GroupStatistics.Count;

        var assignments = (await services.GetRequiredService<IAssignmentRepository>().GetAllAsync()).ToDictionary(a => a.Code);
        assignmentCount = assignments.Count;

        var submissions = await submissionRepository.SearchSubmissionsAsync(new SubmissionFilter { GroupId = Id });

        results = AssignmentResult.For(submissions, assignments);
        adventurers = submissions
            .Where(s => s.Kind.IsAdventurers() && s.AssignmentCode != null)
            .OrderBy(s => s.Kind).ThenBy(s => s.AssignmentCode, AssignmentCode.Comparer).ThenByDescending(s => s.CreatedAt)
            .ToList();

        unresolved = submissions
            .Where(s => s.AssignmentCode == null)
            .OrderByDescending(s => s.CreatedAt)
            .ToList();

        loaded = true;
    }
}
