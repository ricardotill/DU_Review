@using Microsoft.Extensions.Logging
@using ScoutingAutomation.Domain.Exceptions
@inject IServiceScopeFactory ScopeFactory
@inject ISubmissionChangeNotifier ChangeNotifier
@inject ILogger<BonusPointsPanel> Logger

@inject RuntimeSettingsService Runtime
@implements IDisposable

@* Points earned outside Slack, entered by hand: one field per category in use, per group. The Avonturiers category is
   computed (half-hour assignments plus final game): there only the final game is entered, and the total is shown. *@
<AuthorizeView Roles="@AppAuth.AdminRole">
    <div class="glass-panel p-4 bonus-points">
        <h2 class="panel-title"><i class="bi bi-trophy text-warning"></i> Extra punten</h2>
        <p class="text-secondary small">
            Punten die buiten Slack worden verdiend@(categories.Count > 0 ? $", zoals {string.Join(" en ", categories.Select(c => c.Name))}" : "").
            Ze tellen mee in de score en de stand, en blijven staan bij opnieuw opbouwen uit Slack.
        </p>
        @if (FixedKey != null)
        {
            <p class="text-secondary small adventurers-hint">
                <strong>Avonturiers</strong>: vul hier de punten van het <strong>eindspel</strong> in (hoogstens @FinalMax, eventueel met de startbonus voor eigen vervoer).
                Daaronder staat het totaal dat telt: de half-uur opdrachten (hoogstens @Runtime.ThemeMaxPoints) plus het eindspel. Dat rekent de app zelf uit.
            </p>
        }

        @if (categories.Count == 0)
        {
            <div class="text-secondary small">Er zijn geen categorieën. Voeg er een toe bij Puntencategorieën.</div>
        }
        else if (rows.Count == 0)
        {
            <div class="text-secondary small">Nog geen groepen.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Groep</th>
                            @foreach (var category in categories)
                            {
                                <th style="width: 10rem;">@(category.Key == FixedKey ? $"{category.Name}: eindspel" : category.Name)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr @key="row.GroupId">
                                <td class="text-white">@row.Name</td>
                                @foreach (var category in categories)
                                {
                                    var key = category.Key;
                                    var isFixed = key == FixedKey;
                                    <td>
                                        <input type="number" min="0" max="@(isFixed ? FinalMax : BonusPointsChange.MaxPoints)" step="1" class="form-control form-control-dark form-control-sm bonus-input bonus-@key"
                                               aria-label="@(isFixed ? $"Eindspel Avonturiers voor {row.Name}" : $"{category.Name} voor {row.Name}")"
                                               value="@row.Values.GetValueOrDefault(key)"
                                               @onchange="e => row.Values[key] = int.TryParse(e.Value?.ToString(), out var v) ? v : null" />
                                        @if (isFixed && adventurers?.For(row.GroupId) is { } score)
                                        {
                                            <div class="small text-secondary mt-1 adventurers-total" title="Half-uur opdrachten + eindspel">
                                                Totaal <span class="text-white fw-semibold">@score.Total</span> (@score.ThemePoints + @score.FinalPoints)
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex align-items-center gap-3 mt-3">
                <button class="btn btn-scout-primary btn-sm save-bonus" disabled="@saving" @onclick="SaveAsync">
                    <i class="bi bi-check2 me-1"></i> Opslaan
                </button>
                @if (message != null)
                {
                    <span class="small bonus-message @(messageIsError ? "text-danger" : "text-success")" role="status">@message</span>
                }
            </div>
        }
    </div>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private sealed class Row
    {
        public Guid GroupId { get; init; }
        public string Name { get; init; } = "";

        /// <summary>As loaded, per category key: a save checks nobody changed them since.</summary>
        public Dictionary<string, int> Saved { get; init; } = new();

        /// <summary>As entered, per category key; null for an empty or unreadable field.</summary>
        public Dictionary<string, int?> Values { get; init; } = new();

        public IEnumerable<string> ChangedKeys => Values.Where(v => v.Value != Saved.GetValueOrDefault(v.Key)).Select(v => v.Key);
    }

    private IReadOnlyList<BonusCategoryConfig> categories = Array.Empty<BonusCategoryConfig>();
    private AdventurersStanding? adventurers;

    /// <summary>The Avonturiers category, whose field is the final game; null while that part is off.</summary>
    private string? FixedKey => Runtime.FixedBonusKey;

    private int FinalMax => Runtime.FinalMaxPoints;
    private List<Row> rows = new();
    private bool saving;
    private string? message;
    private bool messageIsError;

    protected override async Task OnInitializedAsync()
    {
        Runtime.Changed += OnRuntimeChanged;
        ChangeNotifier.Changed += OnPointsChanged;
        await LoadAsync(keepEdits: false);
    }

    /// <param name="keepEdits">Keep what was typed but not saved, e.g. when another admin added a category.</param>
    private async Task LoadAsync(bool keepEdits)
    {
        // A fresh scope: the circuit's own DbContext would live as long as the tab
        await using var scope = ScopeFactory.CreateAsyncScope();
        var repository = scope.ServiceProvider.GetRequiredService<IGroupRepository>();
        var groups = await repository.GetAllAsync();
        var points = (await repository.GetBonusPointsAsync()).ToDictionary(p => (p.GroupId, p.CategoryKey), p => p.Points);
        var previous = keepEdits ? rows.ToDictionary(r => r.GroupId) : new Dictionary<Guid, Row>();

        categories = Runtime.BonusCategories;
        adventurers = await LoadAdventurersAsync(scope.ServiceProvider);
        rows = groups
            .Select(g =>
            {
                var saved = categories.ToDictionary(c => c.Key, c => points.GetValueOrDefault((g.Id, c.Key)));
                var values = saved.ToDictionary(v => v.Key, v => (int?)v.Value);
                if (previous.TryGetValue(g.Id, out var old))
                {
                    foreach (var key in old.ChangedKeys.Where(values.ContainsKey)) values[key] = old.Values[key];
                }

                return new Row { GroupId = g.Id, Name = g.Name, Saved = saved, Values = values };
            })
            .ToList();
    }

    private void OnRuntimeChanged()
    {
        // Only a change to the categories matters here
        if (Runtime.BonusCategories.Select(c => (c.Key, c.Name)).SequenceEqual(categories.Select(c => (c.Key, c.Name)))) return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadAsync(keepEdits: true);
                StateHasChanged();
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                Logger.LogWarning(ex, "Reloading the bonus points after a category change failed");
            }
        });
    }

    private static bool IsValid(int? points) => points is >= 0 and <= BonusPointsChange.MaxPoints;

    private async Task<AdventurersStanding?> LoadAdventurersAsync(IServiceProvider services) => FixedKey == null
        ? null
        : (await services.GetRequiredService<AdventurersScoreService>().GetOverviewAsync()).Standing;

    /// <summary>A review or round changed the Avonturiers totals: show them again, without touching what is typed.</summary>
    private void OnPointsChanged()
    {
        if (FixedKey == null) return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await using var scope = ScopeFactory.CreateAsyncScope();
                adventurers = await LoadAdventurersAsync(scope.ServiceProvider);
                StateHasChanged();
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                Logger.LogWarning(ex, "Reloading the Avonturiers totals failed");
            }
        });
    }

    private async Task SaveAsync()
    {
        // An empty field or a typo saves nothing: half a pubquiz result on the scoreboard would mislead
        var invalid = rows.FirstOrDefault(r => r.Values.Values.Any(v => !IsValid(v)));
        if (invalid != null)
        {
            (message, messageIsError) = ($"Vul voor {invalid.Name} hele getallen van 0 tot en met {BonusPointsChange.MaxPoints} in. Er is niets opgeslagen.", true);
            return;
        }

        // More than the final game can give would never count, and look like a typo on the scoreboard
        // Only fields changed here: a value saved before the maximum was lowered must not block every other save
        var tooHigh = FixedKey == null ? null : rows.FirstOrDefault(r => r.ChangedKeys.Contains(FixedKey) && r.Values.GetValueOrDefault(FixedKey) > FinalMax);
        if (tooHigh != null)
        {
            (message, messageIsError) = ($"Het eindspel van {tooHigh.Name} is hoogstens {FinalMax} punten. Er is niets opgeslagen.", true);
            return;
        }

        // Only what this tab changed: fields left alone never undo what another admin entered meanwhile
        var changes = rows
            .SelectMany(r => r.ChangedKeys.Select(key => new BonusPointsChange(r.GroupId, key, r.Saved.GetValueOrDefault(key), r.Values[key]!.Value)))
            .ToList();
        if (changes.Count == 0)
        {
            (message, messageIsError) = ("Niets gewijzigd.", false);
            return;
        }

        saving = true;
        try
        {
            var error = await AdminActions.RunTaskAsync(AuthState, async () =>
            {
                await using var scope = ScopeFactory.CreateAsyncScope();
                await scope.ServiceProvider.GetRequiredService<IGroupRepository>().SetBonusPointsAsync(changes);
                return null;
            });

            if (error != null)
            {
                (message, messageIsError) = (error, true);
                return;
            }

            ChangeNotifier.NotifyChanged();
            (message, messageIsError) = ("Opgeslagen.", false);
            await LoadAsync(keepEdits: false);
        }
        catch (BonusPointsConflictException ex)
        {
            (message, messageIsError) = (ex.Message, true);
            await LoadAsync(keepEdits: false);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Saving bonus points failed");
            (message, messageIsError) = ($"Dat is mislukt: {ex.Message}. Er is niets opgeslagen.", true);
        }
        finally
        {
            saving = false;
        }
    }

    public void Dispose()
    {
        Runtime.Changed -= OnRuntimeChanged;
        ChangeNotifier.Changed -= OnPointsChanged;
    }
}
