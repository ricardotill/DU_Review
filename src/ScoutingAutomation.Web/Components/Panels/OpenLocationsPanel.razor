@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject ISubmissionChangeNotifier Notifier
@inject RuntimeSettingsService Runtime

@* How many locations each group has open (1 through N): they appear on the group's map, and only check-ins at open
   locations unlock assignments. The organisation raises the number during the game. *@
<div class="glass-panel p-4">
    <h2 class="panel-title"><i class="bi bi-unlock-fill text-success"></i> Open locaties per groep</h2>
    @if (!Runtime.AdventurersEnabled)
    {
        <p class="text-muted small mb-0">Het Avonturiers-deel staat uit.</p>
    }
    else if (locations.Count == 0)
    {
        <p class="text-muted small mb-0">Nog geen locaties. Voeg ze toe op <a href="avonturiers/locaties">Locaties</a>. Zolang er geen locaties zijn, zijn alle opdrachten open.</p>
    }
    else
    {
        <p class="text-secondary small">
            Een groep heeft locatie 1 tot en met het nummer open. Leeg is het startaantal (t/m @Runtime.InitialOpenLocations).
            Een check-in op een locatie die nog niet open is, telt zodra je het nummer verhoogt.
            Elke getelde locatie opent opdrachten: de eerste @Runtime.InitialOpenAssignments zijn altijd open, de rest gaat naar rato van de @locations.Count locaties.
        </p>
        <div class="table-responsive">
            <table class="custom-table small open-locations">
                <thead>
                    <tr>
                        <th>Groep</th>
                        <th>Open t/m locatie</th>
                        <th title="Goedgekeurde check-ins / waarvan meetellend: op een open locatie en de ronde is voorbij. Wacht: telt na het einde van de ronde">Check-ins</th>
                        <th>Opdrachten open</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in groups)
                    {
                        var state = states.GetValueOrDefault(group.Id);
                        var groupId = group.Id;
                        <tr>
                            <td class="text-nowrap">@group.Name</td>
                            <td>
                                <div class="d-flex gap-1 align-items-center">
                                    <input type="number" min="0" max="@MaxNumber" class="form-control form-control-dark form-control-sm open-input" style="width: 6rem"
                                           aria-label="@group.Name: open tot en met locatie" placeholder="@Runtime.InitialOpenLocations"
                                           value="@group.OpenLocations" @onchange="e => SetAsync(groupId, e.Value?.ToString())" />
                                    <button type="button" class="btn btn-sm btn-scout-secondary open-plus" title="Eén locatie meer open"
                                            @onclick="() => SetAsync(groupId, ((state?.OpenLocations ?? Runtime.InitialOpenLocations) + 1).ToString())">+1</button>
                                </div>
                            </td>
                            <td>@(state?.ApprovedLocations.Count ?? 0) / @(state?.CountedLocations.Count ?? 0)@if (state?.WaitingLocations.Count > 0)
                                {<span class="text-secondary"> (+@state.WaitingLocations.Count wacht)</span>}</td>
                            <td>@(state is { } s ? $"{s.OpenCount} van {s.Total}" : "–")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (error != null)
    {
        <div class="text-danger small mt-2">@error</div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private const int MaxNumber = LocationImport.MaxNumber;

    private IReadOnlyList<Group> groups = Array.Empty<Group>();
    private IReadOnlyList<Location> locations = Array.Empty<Location>();
    private IReadOnlyDictionary<Guid, UnlockState> states = new Dictionary<Guid, UnlockState>();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Notifier.Changed += OnChanged;
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        groups = await scope.ServiceProvider.GetRequiredService<IGroupRepository>().GetAllAsync();
        locations = await scope.ServiceProvider.GetRequiredService<LocationService>().GetAllAsync();
        states = await scope.ServiceProvider.GetRequiredService<AssignmentUnlockService>().ForAllAsync();
    }

    private async Task SetAsync(Guid groupId, string? value)
    {
        int? number = null;
        if (!string.IsNullOrWhiteSpace(value))
        {
            if (!int.TryParse(value, out var parsed))
            {
                error = "Vul een nummer in, of laat het leeg voor het startaantal.";
                return;
            }

            number = parsed;
        }

        error = await AdminActions.RunTaskAsync(AuthState, async () =>
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            return await scope.ServiceProvider.GetRequiredService<LocationService>().SetOpenLocationsAsync(groupId, number);
        });
        await LoadAsync();
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Notifier.Changed -= OnChanged;
}
