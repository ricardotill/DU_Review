@implements IDisposable
@inject ISlackRebuildService RebuildService
@inject RuntimeSettingsService Runtime

<div class="glass-panel p-4">
    <h2 class="panel-title"><i class="bi bi-arrow-repeat text-warning"></i> Opnieuw opbouwen uit Slack</h2>

    @if (!RebuildService.IsAvailable && progress.State == RebuildState.Idle)
    {
        <p class="text-secondary small mb-0">
            Beschikbaar als de app met Slack is verbonden: <code>SimulationMode</code> uit en een bot-token ingesteld.
        </p>
    }
    else
    {
        <details class="rebuild-panel" open="@(progress.State != RebuildState.Idle)">
            <summary class="text-secondary small">@(Group == null ? "Alle inzendingen opnieuw opbouwen uit de Slack-berichten…" : $"De inzendingen van {Group.Name} opnieuw opbouwen uit het Slack-kanaal…")</summary>

            <div class="mt-3">
                <div class="alert alert-warning small" role="alert">
                    <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> @(Group == null ? "Dit vervangt alle inzendingen" : $"Dit vervangt alle inzendingen van {Group.Name}")</div>
                    <ul class="mb-0 ps-3">
                        @if (Group == null)
                        {
                            <li>Alle groepsmappen gaan naar een back-upmap, en alle inzendingen en beoordelingen worden verwijderd.</li>
                        }
                        else
                        {
                            <li>De map van @Group.Name gaat naar een back-upmap, en de inzendingen en beoordelingen van deze groep worden verwijderd. Andere groepen blijven ongemoeid.</li>
                        }
                        <li>Elk bericht met een bestand sinds de gekozen tijd wordt opnieuw verwerkt (nooit van vóór de starttijd van het spel), en beoordelingen komen uit de emoji's die nu in Slack staan. Zijn juryleden het oneens, dan telt de beste status.</li>
                        <li>Handmatige aanpassingen gaan verloren; ze blijven bewaard in <code>submissions.json</code> in de back-up.</li>
                        <li>Er wordt niets in Slack geplaatst. Nieuwe gebeurtenissen wachten tot het opbouwen klaar is.</li>
                        <li>Mist er maar één bericht of beoordeling? Draai dan eerst het mislukte event opnieuw of start een catch-up op <a href="events">Gebeurtenissen</a>.</li>
                    </ul>
                </div>

                <div class="row g-2 align-items-end mb-2">
                    <div class="col-md-5">
                        <label class="form-label text-secondary small fw-semibold mb-1">Berichten vanaf</label>
                        <input type="datetime-local" class="form-control form-control-dark" min="@MinTime" max="@MaxTime" @bind="since" disabled="@IsRunning" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-secondary small fw-semibold mb-1">Typ OPBOUWEN om te bevestigen</label>
                        <input type="text" class="form-control form-control-dark" @bind="confirmation" @bind:event="oninput" disabled="@IsRunning" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-outline-warning w-100" disabled="@(!CanStart)" @onclick="Start">
                            <i class="bi bi-arrow-repeat me-1"></i> Opbouwen
                        </button>
                    </div>
                </div>
                @if (startError != null)
                {
                    <div class="text-danger small mt-2 start-error">@startError</div>
                }

                @if (progress.State != RebuildState.Idle)
                {
                    <div class="inset-panel small mt-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            @switch (progress.State)
                            {
                                case RebuildState.Running:
                                    <span class="spinner-border spinner-border-sm text-warning" role="status"></span>
                                    <span class="fw-semibold text-white">@progress.Step…</span>
                                    break;
                                case RebuildState.Completed:
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <span class="fw-semibold text-white">Opnieuw opbouwen klaar</span>
                                    break;
                                default:
                                    <i class="bi bi-x-circle-fill text-danger"></i>
                                    <span class="fw-semibold text-danger">Opnieuw opbouwen mislukt: @progress.Error</span>
                                    break;
                            }
                        </div>

                        <dl class="rebuild-stats mb-0">
                            <dt>Groepen</dt><dd>@(progress.GroupName ?? "Alle groepen")</dd>
                            <dt>Kanalen gelezen</dt><dd>@progress.ChannelsRead / @progress.ChannelsTotal</dd>
                            <dt>Berichten</dt><dd>@progress.MessagesProcessed / @progress.MessagesFound</dd>
                            <dt>Inzendingen geïmporteerd</dt><dd>@progress.SubmissionsImported</dd>
                            <dt>Beoordelingen verwerkt</dt><dd>@progress.ReviewsApplied</dd>
                            @if (progress.BackupFolder != null)
                            {
                                <dt>Back-up</dt><dd class="font-monospace text-break">@progress.BackupFolder</dd>
                            }
                        </dl>

                        @if (progress.ChannelProblems.Count > 0)
                        {
                            <div class="fw-semibold text-danger mt-3 mb-1">Kanalen die niet gelezen konden worden (@progress.ChannelProblems.Count)</div>
                            <ul class="list-unstyled mb-0 d-flex flex-column gap-2 channel-problems">
                                @foreach (var problem in progress.ChannelProblems)
                                {
                                    <li>
                                        <span class="text-white fw-semibold">@problem.Group</span>
                                        <span class="font-monospace text-muted">#@problem.ChannelId</span>
                                        · <code>@problem.Error</code>
                                        <div class="text-white-50">@problem.Advice</div>
                                    </li>
                                }
                            </ul>
                        }

                        @if (progress.Conflicts.Count > 0)
                        {
                            <div class="fw-semibold text-warning mt-3 mb-1">Juryleden waren het oneens (@progress.Conflicts.Count)</div>
                            <IssueList Issues="progress.Conflicts" />
                        }

                        @if (progress.Skipped.Count > 0)
                        {
                            <div class="fw-semibold text-white mt-3 mb-1">Niet geïmporteerd (@progress.Skipped.Count)</div>
                            <IssueList Issues="progress.Skipped" />
                        }
                    </div>
                }
            </div>
        </details>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly string MinTime = RuntimeSettingsService.MinEventTime.ToString("yyyy-MM-ddTHH:mm");
    private static readonly string MaxTime = RuntimeSettingsService.MaxEventTime.AddMinutes(-1).ToString("yyyy-MM-ddTHH:mm");

    /// <summary>The one group to rebuild; null rebuilds all groups.</summary>
    [Parameter]
    public Group? Group { get; set; }

    private RebuildProgress progress = new();
    private DateTime since;
    private string confirmation = "";
    private string? startError;

    private bool IsRunning => progress.State == RebuildState.Running;

    private bool CanStart => RebuildService.IsAvailable && !IsRunning && confirmation.Trim() == "OPBOUWEN";

    protected override void OnInitialized()
    {
        // From midnight, or from the event start when that is later: earlier messages never count
        since = Runtime.NotBeforeEventStart(GameTime.FromGameTime(DateTimeOffset.UtcNow.ToGameTime().Date)).ToGameTime().DateTime;
        progress = RebuildService.Progress;
        RebuildService.Changed += OnProgressChanged;
    }

    private async Task Start()
    {
        // Replaces every submission: checked on the server, not only by who sees the button
        if (!await AdminActions.IsAdminAsync(AuthState))
        {
            startError = AdminActions.NotAdmin;
            return;
        }

        // A typo such as year 0001 cannot be converted to a point in time
        if (!RuntimeSettingsService.IsValidEventTime(since))
        {
            startError = $"Kies een tijd tussen {RuntimeSettingsService.MinEventTime.Year} en {RuntimeSettingsService.MaxEventTime.Year}.";
            return;
        }

        startError = null;
        // The chosen time is in the game's time zone
        var start = GameTime.FromGameTime(since);
        RebuildService.TryStart(start, Group?.Id);
        confirmation = "";
        progress = RebuildService.Progress;
    }

    private void OnProgressChanged() => InvokeAsync(() =>
    {
        progress = RebuildService.Progress;
        StateHasChanged();
    });

    public void Dispose() => RebuildService.Changed -= OnProgressChanged;
}
