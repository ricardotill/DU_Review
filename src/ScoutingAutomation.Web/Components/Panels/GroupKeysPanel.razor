@implements IDisposable
@inject AccessKeyService Keys
@inject IServiceScopeFactory ScopeFactory

@* A key per group: with it a group sees its own dashboard and uploads, nothing of the jury or the other groups. *@
<AuthorizeView Roles="@KeyAuth.AdminRole">
    <div class="glass-panel p-4 group-keys">
        <h2 class="panel-title"><i class="bi bi-people-fill text-success"></i> Groepssleutels</h2>
        <p class="text-secondary small">
            Geef elke groep haar eigen sleutel. Een groep ziet daarmee alleen het dashboard, haar eigen inzendingen en de stand
            (zolang die niet verborgen is). Een nieuwe sleutel logt die groep uit.
        </p>

        @if (groups.Count == 0)
        {
            <div class="text-secondary small">Nog geen groepen.</div>
        }
        else
        {
            <button type="button" class="btn btn-sm btn-scout-secondary mb-3 make-missing" disabled="@(!AnyMissing)" @onclick="MakeMissingAsync">
                <i class="bi bi-key me-1"></i> Sleutels maken voor groepen zonder sleutel
            </button>

            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Groep</th>
                            <th>Sleutel</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in groups)
                        {
                            var key = Keys.GroupKey(group.SlackChannelId);
                            <tr @key="group.Id">
                                <td class="text-white">@group.Name</td>
                                <td>
                                    @if (key == null)
                                    {
                                        <span class="text-muted small">geen sleutel</span>
                                    }
                                    else
                                    {
                                        <code class="access-key group-key">@key</code>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-warning text-nowrap regenerate-group-key" @onclick="() => RegenerateAsync(group)">
                                        <i class="bi bi-arrow-repeat me-1"></i> @(key == null ? "Sleutel maken" : "Nieuwe sleutel")
                                    </button>
                                    @if (key != null)
                                    {
                                        <button type="button" class="btn btn-sm btn-link text-danger remove-group-key" title="Sleutel intrekken" aria-label="@($"Sleutel van {group.Name} intrekken")" @onclick="() => RemoveAsync(group)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (error != null)
        {
            <div class="text-danger small mt-2" role="alert">@error</div>
        }
    </div>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<Group> groups = new List<Group>();
    private string? error;

    private bool AnyMissing => groups.Any(g => Keys.GroupKey(g.SlackChannelId) == null);

    protected override async Task OnInitializedAsync()
    {
        Keys.Changed += OnKeysChanged;
        await using var scope = ScopeFactory.CreateAsyncScope();
        groups = (await scope.ServiceProvider.GetRequiredService<IGroupRepository>().GetAllAsync()).OrderBy(g => g.Name).ToList();
    }

    private async Task MakeMissingAsync() =>
        error = await AdminActions.RunAsync(AuthState, () => { Keys.EnsureGroupKeys(groups.Select(g => g.SlackChannelId)); });

    private async Task RegenerateAsync(Group group) =>
        error = await AdminActions.RunAsync(AuthState, () => { Keys.RegenerateGroupKey(group.SlackChannelId); });

    private async Task RemoveAsync(Group group) =>
        error = await AdminActions.RunAsync(AuthState, () => { Keys.RemoveGroupKey(group.SlackChannelId); });

    // Another admin's change shows here too
    private void OnKeysChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Keys.Changed -= OnKeysChanged;
}
