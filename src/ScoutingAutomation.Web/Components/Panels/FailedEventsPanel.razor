@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject RuntimeSettingsService Runtime
@inject ILogger<FailedEventsPanel> Logger
@inject ISlackCatchUpService CatchUp
@inject SlackEventLog EventLog

<div class="glass-panel p-4 mb-4 failed-events">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h2 class="h6 fw-bold text-white mb-0 me-auto">
            <i class="bi bi-exclamation-triangle text-danger me-1"></i>
            Mislukte events
            <span class="badge @(failures.Count > 0 ? "badge-rejected" : "badge-approved") ms-1">@failures.Count</span>
        </h2>
        <AuthorizeView Roles="@AppAuth.AdminRole">
            <button class="btn btn-sm btn-scout-secondary retry-all" disabled="@(busy || failures.Count == 0)" @onclick="RetryAll">
                <i class="bi bi-arrow-clockwise me-1"></i> Alles opnieuw
            </button>
            <button class="btn btn-sm btn-scout-secondary run-catch-up" disabled="@busy" @onclick="RunCatchUp"
                    title="Leest de berichten van vandaag opnieuw uit Slack en vult aan wat ontbreekt. Verwijdert niets.">
                <i class="bi bi-arrow-repeat me-1"></i> Catch-up nu draaien
            </button>
        </AuthorizeView>
    </div>
    <p class="text-secondary small mb-3">
        Events die de app niet kon verwerken. Opnieuw draaien laat dashboard-aanpassingen staan; een rebuild is dan meestal niet nodig.
    </p>
    @if (Runtime.ManualMode)
    {
        <div class="alert alert-warning small manual-mode-note" role="note">
            Handmatige modus staat aan: berichten worden niet opnieuw verwerkt en de catch-up draait niet, want die zouden bestanden dubbel opslaan.
            Emoji kunnen wel opnieuw.
        </div>
    }

    @if (message != null)
    {
        <div class="small mb-3 retry-message @(messageIsError ? "text-danger" : "text-success")">@message</div>
    }

    @if (failures.Count == 0)
    {
        <div class="text-secondary small">Geen openstaande fouten.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Eerste fout</th>
                        <th>Soort</th>
                        <th>Groep</th>
                        <th>Fout</th>
                        <th>Pogingen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in failures)
                    {
                        <tr @key="f.Id">
                            <td class="text-white-50 text-nowrap">@f.CreatedAt.ToGameTime().ToString("HH:mm:ss")</td>
                            <td class="text-nowrap">@KindLabel(f.Kind)</td>
                            <td class="text-white">@GroupName(f.ChannelId)</td>
                            <td class="text-white-50 small event-detail">@f.Error</td>
                            <td class="text-white-50">@f.Attempts</td>
                            <td class="text-end text-nowrap">
                                <AuthorizeView Roles="@AppAuth.AdminRole" Context="admin">
                                    <button class="btn btn-sm btn-scout-secondary retry-one" disabled="@busy" @onclick="() => Retry(f.Id)">Opnieuw</button>
                                    <button class="btn btn-sm btn-outline-secondary dismiss-one" disabled="@busy" @onclick="() => Dismiss(f.Id)"
                                            title="Niet meer tonen, bijvoorbeeld een emoji op een bericht zonder bestand">Negeren</button>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Channel id to group name.</summary>
    [Parameter] public IReadOnlyDictionary<string, string> GroupNames { get; set; } = new Dictionary<string, string>();

    /// <summary>At most one reload per this long, however many events arrive.</summary>
    public static readonly TimeSpan ReloadInterval = TimeSpan.FromSeconds(1);

    private IReadOnlyList<FailedSlackEvent> failures = Array.Empty<FailedSlackEvent>();
    private int reloadQueued;
    private bool busy;
    private string? message;
    private bool messageIsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        EventLog.Added += OnAdded;
    }

    // A new failure, or a Slack retry that went through, changes the list. Anything else cannot, and on game day
    // events arrive in bursts: one reload covers a whole burst, not one database query per event per open tab.
    private void OnAdded(SlackEventLogEntry entry)
    {
        if (entry.Outcome != SlackEventOutcome.Failed && failures.Count == 0) return;
        if (Interlocked.Exchange(ref reloadQueued, 1) == 1) return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(ReloadInterval);
                Volatile.Write(ref reloadQueued, 0);
                await LoadAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                // The page keeps the list it had; the next event tries again
                Volatile.Write(ref reloadQueued, 0);
                Logger.LogWarning(ex, "Could not reload the failed Slack events");
            }
        });
    }

    private async Task LoadAsync()
    {
        // A fresh scope: the circuit's own DbContext would live as long as the tab
        await using var scope = ScopeFactory.CreateAsyncScope();
        failures = await scope.ServiceProvider.GetRequiredService<IFailedSlackEventRepository>().GetPendingAsync();
    }

    private Task Retry(Guid id) => RunAsync(async retry =>
    {
        var result = await retry.RetryAsync(id);
        return (result.Resolved ? "Opnieuw verwerkt." : $"Weer mislukt: {result.Message}", !result.Resolved);
    });

    private Task RetryAll() => RunAsync(async retry =>
    {
        var total = failures.Count;
        var resolved = await retry.RetryAllPendingAsync();
        return resolved is { } count
            ? ($"{count} van {total} opnieuw verwerkt.", count < total)
            : (SlackEventRetryService.Busy, true);
    });

    private Task Dismiss(Guid id) => RunAsync(async retry =>
    {
        await retry.DismissAsync(id);
        return ("Genegeerd.", false);
    });

    private async Task RunCatchUp()
    {
        if (Runtime.ManualMode)
        {
            (message, messageIsError) = ("Handmatige modus staat aan: de catch-up draait dan niet.", true);
            return;
        }

        var error = await AdminActions.RunAsync(AuthState, () => CatchUp.Request("requested on the events page"));
        (message, messageIsError) = error != null
            ? (error, true)
            : ("Catch-up gestart; het resultaat verschijnt hieronder in de gebeurtenissen.", false);
    }

    private async Task RunAsync(Func<SlackEventRetryService, Task<(string Text, bool IsError)>> action)
    {
        busy = true;
        try
        {
            (string Text, bool IsError) outcome = default;
            var error = await AdminActions.RunTaskAsync(AuthState, async () =>
            {
                await using var scope = ScopeFactory.CreateAsyncScope();
                outcome = await action(scope.ServiceProvider.GetRequiredService<SlackEventRetryService>());
                return null;
            });
            (message, messageIsError) = error != null ? (error, true) : outcome;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Action on failed Slack events failed");
            (message, messageIsError) = ($"Dat is mislukt: {ex.Message}", true);
        }
        finally
        {
            busy = false;
        }
    }

    private string GroupName(string? channel) =>
        channel == null ? "–" : GroupNames.GetValueOrDefault(channel) ?? $"#{channel}";

    private static string KindLabel(string kind) => kind switch
    {
        nameof(SlackEventKind.Message) => "Bericht",
        nameof(SlackEventKind.Edited) => "Bewerkt",
        nameof(SlackEventKind.Deleted) => "Verwijderd",
        nameof(SlackEventKind.ReactionAdded) => "Emoji geplaatst",
        nameof(SlackEventKind.ReactionRemoved) => "Emoji weggehaald",
        _ => kind
    };

    public void Dispose() => EventLog.Added -= OnAdded;
}
