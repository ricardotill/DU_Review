@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject ISubmissionChangeNotifier Notifier
@inject RuntimeSettingsService Runtime

@* Which locations each group unlocked (through its Reisbureau): they appear on the group's map, and with
   RequireUnlockedLocation the jury is warned about a check-in at a location that is not unlocked. *@
<div class="glass-panel p-4">
    <h2 class="panel-title"><i class="bi bi-unlock-fill text-success"></i> Vrijgespeelde locaties</h2>
    @if (!Runtime.AdventurersEnabled)
    {
        <p class="text-muted small mb-0">Het Avonturiers-deel staat uit.</p>
    }
    else if (locations.Count == 0)
    {
        <p class="text-muted small mb-0">Nog geen locaties. Voeg ze toe op <a href="avonturiers/locaties">Locaties</a>.</p>
    }
    else
    {
        <p class="text-secondary small">Een vinkje zet de locatie op de kaart van de groep.</p>
        <div class="form-check form-switch mb-3">
            <input class="form-check-input require-unlocked" type="checkbox" id="requireUnlocked" checked="@Runtime.RequireUnlockedLocation" @onchange="ToggleRequire" />
            <label class="form-check-label text-white-50 small" for="requireUnlocked">Jury waarschuwen bij een check-in op een locatie die niet vrijgespeeld is</label>
        </div>
        <div class="table-responsive">
            <table class="custom-table small unlocks">
                <thead>
                    <tr>
                        <th>Groep</th>
                        @foreach (var location in locations)
                        {
                            <th class="text-center" title="@location.Name">@location.Number</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in groups)
                    {
                        var unlocked = unlocks.GetValueOrDefault(group.Id) ?? new HashSet<int>();
                        <tr>
                            <td class="text-nowrap">@group.Name</td>
                            @foreach (var location in locations)
                            {
                                var number = location.Number;
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" aria-label="@group.Name locatie @number"
                                           checked="@unlocked.Contains(number)" @onchange="e => Toggle(group.Id, number, e)" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (error != null)
    {
        <div class="text-danger small mt-2">@error</div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<Group> groups = Array.Empty<Group>();
    private IReadOnlyList<Location> locations = Array.Empty<Location>();
    private Dictionary<Guid, HashSet<int>> unlocks = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Notifier.Changed += OnChanged;
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var service = scope.ServiceProvider.GetRequiredService<LocationService>();
        groups = await scope.ServiceProvider.GetRequiredService<IGroupRepository>().GetAllAsync();
        locations = await service.GetAllAsync();
        unlocks = (await service.GetUnlocksAsync()).GroupBy(u => u.GroupId).ToDictionary(g => g.Key, g => g.Select(u => u.LocationNumber).ToHashSet());
    }

    private async Task Toggle(Guid groupId, int number, ChangeEventArgs e)
    {
        var on = e.Value is true || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        error = await AdminActions.RunTaskAsync(AuthState, async () =>
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            await scope.ServiceProvider.GetRequiredService<LocationService>().SetUnlockedAsync(groupId, number, on);
            return null;
        });
        await LoadAsync();
    }

    private async Task ToggleRequire(ChangeEventArgs e)
    {
        var on = e.Value is true || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        error = await AdminActions.RunAsync(AuthState, () => Runtime.SetRequireUnlockedLocation(on));
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Notifier.Changed -= OnChanged;
}
