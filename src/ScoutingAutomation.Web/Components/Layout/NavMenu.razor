@inject IOptions<ScoutingSettings> ScoutingOptions

<div class="top-row ps-3 navbar navbar-dark" style="background: rgba(12, 17, 23, 0.95); border-bottom: 1px solid var(--border-color);">
    <div class="container-fluid d-flex align-items-center justify-content-between">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <span style="font-size: 1.4rem;">🏕️</span>
            <div>
                <span class="brand-font fw-bold" style="letter-spacing: -0.02em; color: #fff;">DU</span>
                <span style="color: #10b981; font-weight: 700;">Review</span>
            </div>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()" style="background: #0f141c; border-right: 1px solid var(--border-color);">
    <nav class="nav flex-column p-2 gap-1">
        <div class="nav-item">
            <NavLink class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-3 text-white-50" href="" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2-fill text-emerald" style="color: #10b981;"></i>
                <span class="nav-label fw-medium">Dashboard</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-3 text-white-50" href="submissions">
                <i class="bi bi-folder2-open" style="color: #38bdf8;"></i>
                <span class="nav-label fw-medium">Submissions</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-3 text-white-50" href="assignments">
                <i class="bi bi-list-ol" style="color: #a78bfa;"></i>
                <span class="nav-label fw-medium">Assignments</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-3 text-white-50" href="groups">
                <i class="bi bi-people-fill" style="color: #34d399;"></i>
                <span class="nav-label fw-medium">Groups</span>
            </NavLink>
        </div>

        @if (ScoutingOptions.Value.Slack.SimulationMode)
        {
            <div class="nav-item">
                <NavLink class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-3 text-white-50" href="simulator">
                    <i class="bi bi-slack" style="color: #e01e5a;"></i>
                    <span class="nav-label fw-medium">Slack Simulator</span>
                    <span class="badge ms-auto flex-shrink-0" style="background: rgba(224, 30, 90, 0.2); color: #ff7597; font-size: 0.65rem;">TEST POC</span>
                </NavLink>
            </div>
        }

        <div class="nav-item">
            <NavLink class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-3 text-white-50" href="configuration">
                <i class="bi bi-sliders" style="color: #fbbf24;"></i>
                <span class="nav-label fw-medium">Configuration</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-3 text-white-50" href="admin">
                <i class="bi bi-shield-lock" style="color: #f87171;"></i>
                <span class="nav-label fw-medium">Admin</span>
            </NavLink>
        </div>
    </nav>

    <div class="mt-auto p-3 text-muted d-flex justify-content-between align-items-center" style="font-size: 0.75rem; border-top: 1px solid var(--border-color);">
        <span>Scouting Regional Game</span>
        <form method="post" action="logout">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-link btn-sm text-secondary p-0 logout" title="Log out"><i class="bi bi-box-arrow-right"></i> Log out</button>
        </form>
    </div>
</div>
