@inherits LayoutComponentBase
@inject IOptions<ScoutingSettings> ScoutingOptions
@inject SlackConnectionStatus ConnectionStatus
@inject RuntimeSettingsService Runtime

<div class="page" style="min-height: 100vh; background-color: var(--bg-main);">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="flex-grow-1" style="background-color: var(--bg-main); min-height: 100vh; overflow-y: auto;">
        <div class="top-row px-4 d-flex justify-content-between align-items-center" style="background: rgba(12, 17, 23, 0.7); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border-color); height: 3.5rem;">
            @* Game first, then the connection, then modes that change how the app behaves *@
            <div class="top-tags">
                <GameStatusBadge />
                @* Slack and modes are jury business; a group only sees where the game stands *@
                <AuthorizeView Roles="@KeyAuth.JuryRole">
                    @if (ScoutingOptions.Value.Slack.SimulationMode)
                    {
                        <span class="top-tag badge-pending" title="Er gaan geen berichten naar Slack">
                            <i class="bi bi-cone-striped"></i> Simulatiemodus
                        </span>
                    }
                    else if (ScoutingOptions.Value.Slack.SocketMode && ConnectionStatus.State != SlackConnectionState.Connected)
                    {
                        <a href="configuration" class="top-tag badge-rejected" title="@ConnectionStatus.Detail">
                            <i class="bi bi-exclamation-triangle-fill"></i> Slack: @ConnectionStatus.State.Label()
                        </a>
                    }
                    else
                    {
                        <span class="top-tag badge-approved">
                            <span class="live-dot"></span> Verbonden met Slack
                        </span>
                    }
                    @if (Runtime.ManualMode)
                    {
                        <a href="" class="top-tag badge-pending" title="Bestanden worden alleen gedownload en benoemd">
                            <i class="bi bi-hand-index-thumb"></i> Handmatige modus
                        </a>
                    }
                    <AuthorizeView Roles="@KeyAuth.AdminRole" Context="admin">
                        <a href="admin" class="top-tag badge-awesome" title="Beheermodus: acties voor beheerders zijn beschikbaar">
                            <i class="bi bi-shield-lock-fill"></i> Beheer
                        </a>
                    </AuthorizeView>
                </AuthorizeView>
            </div>
            <AuthorizeView Roles="@KeyAuth.JuryRole">
                <NotificationSettings />
            </AuthorizeView>
        </div>

        <article class="content px-4 py-4" style="max-width: 1400px; margin: 0 auto;">
            @* An error in one page shows a message there, instead of breaking the connection of the whole tab *@
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="exception">
                    <div class="glass-panel p-4 page-error" role="alert">
                        <h2 class="panel-title text-danger"><i class="bi bi-exclamation-octagon-fill"></i> Er ging iets mis op deze pagina</h2>
                        <p class="text-secondary small mb-3">De rest van de app werkt nog. Probeer het opnieuw, of laad de pagina opnieuw.</p>
                        <button type="button" class="btn btn-sm btn-scout-secondary" @onclick="() => errorBoundary?.Recover()">Opnieuw proberen</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet>
    Er is een onverwachte fout opgetreden.
    <a href="." class="reload">Herladen</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    // Going to another page starts with a clean slate
    protected override void OnParametersSet() => errorBoundary?.Recover();
}
