@* An optional picture to send along with an Avonturiers message (e.g. the round's theme or the final location) *@
<div class="d-flex flex-wrap align-items-center gap-2">
    @if (Picture == null)
    {
        <label class="btn btn-sm btn-scout-secondary @(Disabled || loading ? "disabled" : "")">
            <i class="bi bi-image me-1"></i> Foto meesturen
            <InputFile class="d-none" accept="image/*" OnChange="OnChosen" disabled="@(Disabled || loading)" />
        </label>
        @if (loading)
        {
            <div class="spinner-border spinner-border-sm text-success" role="status"><span class="visually-hidden">Foto laden</span></div>
        }
    }
    else
    {
        <span class="small text-white"><i class="bi bi-image me-1"></i>@Picture.FileName</span>
        <button type="button" class="btn btn-sm btn-link text-secondary p-0" aria-label="Foto weghalen" disabled="@Disabled" @onclick="() => PictureChanged.InvokeAsync(null)">
            <i class="bi bi-x-lg"></i>
        </button>
    }
    @if (error != null)
    {
        <span class="text-danger small">@error</span>
    }
</div>

@code {
    [Parameter] public MessagePicture? Picture { get; set; }
    [Parameter] public EventCallback<MessagePicture?> PictureChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool loading;
    private string? error;

    private async Task OnChosen(InputFileChangeEventArgs e)
    {
        error = null;
        if (e.File.Size > GroupMessageSender.MaxPictureBytes)
        {
            error = $"De foto is te groot: maximaal {GroupMessageSender.MaxPictureBytes / 1024 / 1024} MB.";
            return;
        }

        loading = true;
        try
        {
            using var content = new MemoryStream();
            await using (var stream = e.File.OpenReadStream(GroupMessageSender.MaxPictureBytes))
            {
                await stream.CopyToAsync(content);
            }

            var picture = new MessagePicture(GroupMessageSender.SafeFileName(e.File.Name), content.ToArray());
            // The browser's content type is only a claim: the bytes decide
            error = GroupMessageSender.Validate(null, picture);
            if (error == null) await PictureChanged.InvokeAsync(picture);
        }
        catch (Exception ex) when (ex is IOException or JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            error = $"De foto kon niet worden gelezen: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }
}
