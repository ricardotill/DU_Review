@implements IDisposable
@inject NotificationPreferences JuryPreferences
@inject GroupNotificationPreferences GroupPreferences

@* The admin and login pages are not interactive: a menu there could not do anything *@
@if (RendererInfo.IsInteractive)
{
    <div class="notification-settings">
        <button type="button" class="bell-button" aria-expanded="@(open ? "true" : "false")" aria-controls="notification-settings-menu"
                title="@(ForGroups ? "Meldingen voor nieuwe opdrachten" : "Meldingen voor nieuwe inzendingen")" disabled="@(!Preferences.IsLoaded)" @onclick="() => open = !open">
            <i class="bi @(Preferences.ToastsEnabled || Preferences.SoundEnabled || Preferences.SystemEnabled ? "bi-bell-fill" : "bi-bell-slash")"></i>
            <span class="visually-hidden">Meldingen</span>
        </button>

        @if (open)
        {
            <div class="menu-backdrop" @onclick="() => open = false"></div>
            <div id="notification-settings-menu" class="menu glass-panel" role="group" aria-label="Meldingen">
                <div class="menu-title">@(ForGroups ? "Nieuwe opdrachten" : "Nieuwe inzendingen")</div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="notify-toasts"
                           checked="@Preferences.ToastsEnabled" @onchange="e => Preferences.SetToastsEnabledAsync((bool)e.Value!)" />
                    <label class="form-check-label" for="notify-toasts">Meldingen tonen</label>
                </div>
                <div class="form-check form-switch" data-du-sound-toggle>
                    <input class="form-check-input" type="checkbox" role="switch" id="notify-sound"
                           checked="@Preferences.SoundEnabled" @onchange="e => Preferences.SetSoundEnabledAsync((bool)e.Value!)" />
                    <label class="form-check-label" for="notify-sound">Geluid afspelen</label>
                </div>
                @if (ForGroups)
                {
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="notify-system" disabled="@(permission is "unsupported" or "denied")"
                               checked="@Preferences.SystemEnabled" @onchange="e => SetSystemAsync((bool)e.Value!)" />
                        <label class="form-check-label" for="notify-system">Melding van telefoon of computer</label>
                    </div>
                    @if (permission == "denied")
                    {
                        <p class="menu-hint text-warning system-denied">De browser blokkeert meldingen voor deze site. Sta ze toe in de instellingen van de browser.</p>
                    }
                    else if (permission == "unsupported")
                    {
                        <p class="menu-hint system-unsupported">Deze browser kan geen meldingen buiten de pagina tonen (alleen via https).</p>
                    }
                }
                <p class="menu-hint">
                    Geldt alleen voor deze browser. Na het herladen van de pagina speelt het geluid pas als je één keer ergens op de pagina hebt geklikt.
                    @if (ForGroups)
                    {
                        <text>Een melding van de telefoon of computer komt alleen als de app in een tabblad open staat.</text>
                    }
                </p>
            </div>
        }
    </div>
}

@code {
    private bool open;
    private string? permission;

    /// <summary>The menu of a group: notices of newly opened assignments, with their own stored choices.</summary>
    [Parameter] public bool ForGroups { get; set; }

    private NotificationPreferences Preferences => ForGroups ? GroupPreferences : JuryPreferences;

    protected override void OnInitialized()
    {
        JuryPreferences.Changed += OnChanged;
        GroupPreferences.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Preferences.EnsureLoadedAsync();
        if (ForGroups)
        {
            permission = await Preferences.SystemPermissionAsync();
            StateHasChanged();
        }
    }

    private async Task SetSystemAsync(bool enabled) => permission = await Preferences.SetSystemEnabledAsync(enabled);

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        JuryPreferences.Changed -= OnChanged;
        GroupPreferences.Changed -= OnChanged;
    }
}
