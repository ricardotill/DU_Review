@implements IDisposable
@inject RuntimeSettingsService Runtime
@inject ReviewerNameFetcher NameFetcher

<div class="d-flex justify-content-between align-items-center mb-1">
    <div class="field-label mb-0">Juryleden</div>
    @if (NameFetcher.CanFetch)
    {
        <AuthorizeView Roles="@KeyAuth.AdminRole">
            <button type="button" class="btn btn-sm btn-link text-secondary p-0 fetch-names" disabled="@fetching" @onclick="FetchAll">
                <i class="bi bi-arrow-repeat me-1"></i>@(fetching ? "Ophalen…" : "Namen ophalen uit Slack")
            </button>
        </AuthorizeView>
    }
</div>

<ul class="list-unstyled reviewer-list mb-1">
    @foreach (var reviewer in Runtime.AllReviewers)
    {
        var configured = Runtime.ConfiguredReviewers.Contains(reviewer);
        <li class="reviewer d-flex align-items-center gap-2">
            @if (editing == reviewer)
            {
                <form class="d-flex gap-1 flex-grow-1" @onsubmit="SaveName">
                    <input type="text" class="form-control form-control-dark form-control-sm" maxlength="@RuntimeSettingsService.MaxNameLength"
                           aria-label="Naam van @reviewer" placeholder="Naam" @bind="editName" @bind:event="oninput" />
                    <button type="submit" class="btn btn-sm btn-scout-secondary" aria-label="Naam opslaan"><i class="bi bi-check-lg"></i></button>
                    <button type="button" class="btn btn-sm btn-scout-secondary" aria-label="Annuleren" @onclick="() => editing = null"><i class="bi bi-x-lg"></i></button>
                </form>
            }
            else
            {
                <i class="bi @(configured ? "bi-lock-fill text-muted" : "bi-person-plus text-info")" title="@(configured ? "Uit appsettings.json" : "Toegevoegd in de app")"></i>
                <span class="reviewer-name text-white text-truncate">@(Runtime.NameOf(reviewer) ?? "geen naam")</span>
                <span class="font-monospace text-muted small">@reviewer</span>
                <AuthorizeView Roles="@KeyAuth.AdminRole">
                    <span class="ms-auto d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-link text-secondary p-0 edit-name" aria-label="Naam van @reviewer bewerken" @onclick="() => StartEdit(reviewer)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        @if (!configured)
                        {
                            <button type="button" class="btn btn-sm btn-link text-danger p-0 remove-reviewer" aria-label="@reviewer verwijderen" @onclick="() => Remove(reviewer)">
                                <i class="bi bi-trash"></i>
                            </button>
                        }
                    </span>
                </AuthorizeView>
            }
        </li>
    }
</ul>

<div class="stat-caption mb-2">
    @if (Runtime.AllReviewers.Count == 0)
    {
        <span class="text-danger">Geen juryleden: alle reacties worden genegeerd.</span>
    }
    else
    {
        <span>Alleen reacties van deze Slack-gebruikers tellen. Hun eigen berichten zijn nooit inzendingen.</span>
    }
</div>

<AuthorizeView Roles="@KeyAuth.AdminRole">
    <Authorized>
        <form class="d-flex gap-2 mb-1" @onsubmit="Add">
            <input type="text" class="form-control form-control-dark form-control-sm font-monospace" placeholder="Slack-member-ID, bijv. U04ABC123"
                   aria-label="Slack-member-ID" @bind="newReviewer" @bind:event="oninput" />
            <button type="submit" class="btn btn-sm btn-scout-secondary text-nowrap add-reviewer" disabled="@string.IsNullOrWhiteSpace(newReviewer)">
                <i class="bi bi-person-plus me-1"></i> Toevoegen
            </button>
        </form>
        <div class="stat-caption mb-3 reviewer-status">
            @if (message != null)
            {
                <span class="@(messageIsProblem ? "text-danger" : "text-success")">@message</span>
            }
            else
            {
                <span>Toegevoegde juryleden tellen direct mee en blijven bewaard na een herstart. Juryleden met een slotje staan in appsettings.json. Een naam die je invult, wordt nooit vervangen door een naam uit Slack.</span>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="stat-caption mb-3">Alleen beheerders kunnen juryleden toevoegen of hun naam wijzigen.</div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string newReviewer = "";
    private string? editing;
    private string editName = "";
    private string? message;
    private bool messageIsProblem;
    private bool fetching;

    protected override void OnInitialized() => Runtime.Changed += OnChanged;

    private async Task Add()
    {
        var id = newReviewer.Trim();
        var error = await AdminActions.RunAsync(AuthState, () => Runtime.AddReviewer(id));
        if (error != null)
        {
            Show(error, problem: true);
            return;
        }

        newReviewer = "";
        string? problem;
        try
        {
            problem = NameFetcher.CanFetch ? await NameFetcher.FetchAsync(id) : null;
        }
        catch (Exception ex) when (ex is IOException or HttpRequestException or TimeoutException)
        {
            problem = $"De naam kon niet uit Slack worden gehaald: {ex.Message}";
        }

        Show(problem ?? $"{Runtime.DisplayName(id)} is nu jurylid.", problem != null);
    }

    private async Task Remove(string reviewer)
    {
        if (await AdminActions.RunAsync(AuthState, () => Runtime.RemoveReviewer(reviewer)) is { } error)
        {
            Show(error, problem: true);
        }
    }

    private void StartEdit(string reviewer)
    {
        editing = reviewer;
        editName = Runtime.NameOf(reviewer) ?? "";
    }

    private async Task SaveName()
    {
        if (editing == null) return;
        var reviewer = editing;
        var error = await AdminActions.RunAsync(AuthState, () => Runtime.SetReviewerName(reviewer, editName));
        if (error != null)
        {
            Show(error, problem: true);
            return;
        }

        editing = null;
        message = null;
    }

    private async Task FetchAll()
    {
        if (fetching) return;
        if (!await AdminActions.IsAdminAsync(AuthState))
        {
            Show(AdminActions.NotAdmin, problem: true);
            return;
        }

        fetching = true;
        ReviewerNameFetchResult result;
        try
        {
            result = await NameFetcher.FetchAllAsync();
        }
        catch (Exception ex) when (ex is IOException or HttpRequestException or TimeoutException or UnauthorizedAccessException)
        {
            Show($"Namen ophalen is mislukt: {ex.Message}", problem: true);
            return;
        }
        finally
        {
            fetching = false;
        }

        var summary = $"{result.Updated} naam/namen opgehaald uit Slack" + (result.KeptManual > 0 ? $", {result.KeptManual} zoals ingevuld gehouden" : "") + ".";
        Show(result.Problems.Count == 0 ? summary : $"{summary} {string.Join(" ", result.Problems)}", result.Problems.Count > 0);
    }

    private void Show(string text, bool problem)
    {
        message = text;
        messageIsProblem = problem;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Runtime.Changed -= OnChanged;
}
