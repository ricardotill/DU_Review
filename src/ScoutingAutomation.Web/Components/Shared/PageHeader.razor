<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div class="min-w-0">
        @if (!string.IsNullOrEmpty(BackHref))
        {
            <a href="@BackHref" class="back-link">
                <i class="bi bi-arrow-left"></i> @BackText
            </a>
        }
        <h1 class="h2 mb-1 fw-bold text-white text-break">@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="text-secondary mb-0">@Subtitle</p>
        }
        @Details
    </div>
    @if (Actions != null)
    {
        <div class="d-flex gap-2 flex-shrink-0">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public string BackText { get; set; } = "Back";
    [Parameter] public RenderFragment? Details { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
