@implements IDisposable
@inject RuntimeSettingsService Runtime
@inject IOptions<ScoutingSettings> ScoutingOptions

@* Start and end of the game, which admins can change while the app runs. Times are in the game's time zone. *@
<div class="glass-panel p-4">
    <h2 class="panel-title"><i class="bi bi-hourglass-split text-info"></i> Speeltijd</h2>
    <p class="text-secondary small">
        Inzendingen van vóór de starttijd worden genegeerd. Inzendingen vanaf de eindtijd tellen niet: de bot reageert met
        <code>:@(ScoutingOptions.Value.SlackFeedback.TooLate?.Reaction?.Trim(':') ?? "alarm_clock"):</code> en een uitleg.
        De tijd van het Slack-bericht beslist, dus een bericht dat op tijd was blijft tellen, ook als het later wordt aangepast.
    </p>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="fw-semibold text-white small mb-1">Starttijd</div>
            <div class="small text-white mb-2 event-start">@Format(Runtime.EventStartGameTime)</div>
            <AuthorizeView Roles="@KeyAuth.AdminRole">
                <form class="d-flex gap-2 align-items-start" @onsubmit="SaveStart">
                    <input type="datetime-local" class="form-control form-control-dark form-control-sm start-input" aria-label="Starttijd" step="60" @bind="startDraft" />
                    <button type="submit" class="btn btn-sm btn-scout-secondary text-nowrap save-start"><i class="bi bi-check-lg me-1"></i> Opslaan</button>
                </form>
                @if (startError != null)
                {
                    <div class="text-danger small mt-1">@startError</div>
                }
            </AuthorizeView>
            <Origin Changed="Runtime.IsEventStartChanged" Reset="ResetStart" Configured="@Format(ScoutingOptions.Value.EventStart)" />
        </div>

        <div class="col-lg-6">
            <div class="fw-semibold text-white small mb-1">Eindtijd</div>
            <div class="small text-white mb-2 event-end">@Format(Runtime.EventEndGameTime)</div>
            <AuthorizeView Roles="@KeyAuth.AdminRole">
                <form class="d-flex gap-2 align-items-start" @onsubmit="SaveEnd">
                    <input type="datetime-local" class="form-control form-control-dark form-control-sm end-input" aria-label="Eindtijd" step="60" @bind="endDraft" />
                    <button type="submit" class="btn btn-sm btn-scout-secondary text-nowrap save-end"><i class="bi bi-check-lg me-1"></i> Opslaan</button>
                </form>
                @if (endError != null)
                {
                    <div class="text-danger small mt-1">@endError</div>
                }
            </AuthorizeView>
            <Origin Changed="Runtime.IsEventEndChanged" Reset="ResetEnd" Configured="@Format(ScoutingOptions.Value.EventEnd)" />
        </div>
    </div>
    <div class="stat-caption mt-2">Laat een veld leeg en sla op om zonder start- of eindtijd te spelen.</div>
</div>

@code {
    private DateTime? startDraft;
    private DateTime? endDraft;
    private string? startError;
    private string? endError;

    protected override void OnInitialized()
    {
        startDraft = Runtime.EventStartGameTime;
        endDraft = Runtime.EventEndGameTime;
        Runtime.Changed += OnRuntimeChanged;
    }

    private static string Format(DateTime? time) => time?.ToString("dd-MM-yyyy HH:mm") ?? "geen";

    private void SaveStart() => startError = Runtime.SetEventStart(startDraft);

    private void SaveEnd() => endError = Runtime.SetEventEnd(endDraft);

    private void ResetStart()
    {
        Runtime.ResetEventStart();
        startDraft = Runtime.EventStartGameTime;
        startError = null;
    }

    private void ResetEnd()
    {
        Runtime.ResetEventEnd();
        endDraft = Runtime.EventEndGameTime;
        endError = null;
    }

    private void OnRuntimeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Runtime.Changed -= OnRuntimeChanged;
}
